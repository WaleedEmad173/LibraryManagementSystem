@*

*@
@{
}
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
        @{
            var currentPath = Context.Request.Path.Value ?? "/";
            Func<string, string> navActive = (string href) =>
            {
                if (string.IsNullOrEmpty(href)) href = "/";
                // treat root and /Home/Index as home
                if (href == "/" && (currentPath == "/" || currentPath.Equals("/Home") || currentPath.StartsWith("/Home/", StringComparison.OrdinalIgnoreCase)))
                {
                    return "active";
                }
                return currentPath.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
            };
        }
        <a class="navbar-brand d-flex align-items-center" href="/">
            <div class="brand-logo rounded-3 d-flex align-items-center justify-content-center  me-2 ">
                <img src="~/images/icons/book-open.png" alt="Library logo" width="24" height="24" />
            </div>
            <span class="ms-2 fw-semibold">Library Management System</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#guestNavbar" aria-controls="guestNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="guestNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-3">
                <li class="nav-item"><a class="nav-link @navActive("/")" aria-current="page" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link @navActive("/Books")" href="/Books">Books</a></li>
                <li class="nav-item"><a class="nav-link @navActive("/Catalog")" href="/Catalog">Catalog</a></li>
                <li class="nav-item"><a class="nav-link @navActive("/About")" href="/About">About</a></li>
            </ul>

            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-outline-secondary btn-nav-auth" href="/Account/Login">Login</a>
                <a class="btn btn-nav-primary" href="/Account/Register">Register</a>
            </div>
        </div>
    </div>
</nav>



<style>
    /* small style adjustments to match the provided design */
    .brand-logo { width:39px; height:39px; background:#1e3a8a; }
    .brand-logo img { display:block }
    .brand-title { font-size:1.15rem }
    .btn-nav-auth {
        border-radius: 6px;
        padding: 6px 18px;
        font-size: 0.88rem;
        font-weight: 500;
        border-color: #d1d5db;
        color: #374151;
        background-color: #ffffff;
    }
    .btn-nav-auth:hover {
        background-color: #f3f4f6;
        border-color: #9ca3af;
        color: #111827;
    }
    .btn-nav-primary {
        border-radius: 6px;
        padding: 6px 18px;
        font-size: 0.88rem;
        font-weight: 500;
        background-color: #1e3a8a;
        color: #ffffff;
        border: none;
    }
    .btn-nav-primary:hover {
        background-color: #172554;
        color: #ffffff;
    }
</style>
