@model LibraryManagementSystem.ViewModels.BorrowingIndexViewModel
@{
    ViewData["Title"] = "My Borrowings";
    Layout = "_Layout";
}

<div class="borrow-flow-container">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb bg-transparent p-0 m-0 text-muted" style="font-size: 0.875rem;">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">My Borrowings</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-slate-900 mb-1">My Borrowings</h1>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">
                Manage your active book loans, track due dates, and view your complete reading history.
            </p>
        </div>
        <div class="d-flex align-items-center gap-3 mt-3 mt-md-0">
            <span class="status-pill status-pill-active">
                <span class="status-dot"></span> Library Desk Circulation Active
            </span>
            <a asp-action="Confirm" class="btn btn-primary px-3 py-2 rounded-3 fw-semibold d-inline-flex align-items-center gap-2">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                Borrow a Book
            </a>
        </div>
    </div>

    <!-- Alert Feedback from TempData -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <strong>Success!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <strong>Notice:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Cards (Image 2 Mockup) -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="stat-kpi-card p-4 rounded-4 bg-white border">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted fw-bold small text-uppercase tracking-wider">CURRENTLY BORROWED</div>
                        <div class="d-flex align-items-baseline gap-2 mt-2">
                            <span class="display-6 fw-bold text-slate-900">@Model.CurrentlyBorrowedCount</span>
                            <span class="badge bg-amber-100 text-amber-800 rounded-pill px-2 py-1 small">active loans</span>
                        </div>
                    </div>
                    <div class="kpi-icon bg-amber-50 text-amber-600 p-3 rounded-3">
                        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                        </svg>
                    </div>
                </div>
                <div class="mt-3 pt-3 border-top d-flex justify-content-between text-muted small">
                    <span>
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1">
                            <circle cx="12" cy="12" r="10" />
                            <polyline points="12 6 12 12 16 14" />
                        </svg>
                        Standard 14-day circulation
                    </span>
                    <span class="fw-medium">Account ID #MB-4820</span>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="stat-kpi-card p-4 rounded-4 bg-white border">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted fw-bold small text-uppercase tracking-wider">TOTAL BORROWED</div>
                        <div class="d-flex align-items-baseline gap-2 mt-2">
                            <span class="display-6 fw-bold text-slate-900">@Model.TotalBorrowedCount</span>
                            <span class="badge bg-blue-100 text-blue-800 rounded-pill px-2 py-1 small">Lifetime total</span>
                        </div>
                    </div>
                    <div class="kpi-icon bg-blue-50 text-blue-600 p-3 rounded-3">
                        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                    </div>
                </div>
                <div class="mt-3 pt-3 border-top d-flex justify-content-between text-muted small">
                    <span class="text-emerald-700 fw-medium">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1 text-emerald-600">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        Account in Good Standing
                    </span>
                    <span>0 Overdue Penalties</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                <select name="status" class="form-select form-select-sm rounded-3">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.StatusFilter))">All Statuses</option>
                    <option value="Borrowed" selected="@(Model.StatusFilter == "Borrowed")">Borrowed (Active)</option>
                    <option value="Returned" selected="@(Model.StatusFilter == "Returned")">Returned</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">From Date</label>
                <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm rounded-3" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">To Date</label>
                <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm rounded-3" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-dark flex-grow-1 rounded-3 fw-semibold">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                    </svg>
                    Apply
                </button>
                <a asp-action="Index" class="btn btn-sm btn-light border rounded-3 text-muted">Reset</a>
            </div>
        </form>
    </div>

    <!-- Borrowings Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Book Details</th>
                        <th class="py-3">Borrow Date</th>
                        <th class="py-3">Return Date</th>
                        <th class="py-3">Status</th>
                        <th class="text-end pe-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.Borrowings.Any())
                    {
                        @foreach (var item in Model.Borrowings)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="book-row-icon bg-light text-primary p-2 rounded-3 border">
                                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-slate-900">@item.BookTitle</div>
                                            <div class="text-muted small">@item.BookAuthor</div>
                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                <span class="text-muted" style="font-size: 0.75rem;">ISBN @item.BookISBN</span>
                                                <span class="badge bg-light text-secondary border px-2 py-0" style="font-size: 0.7rem;">@item.CategoryName</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="fw-semibold text-slate-900 small">@item.BorrowDate.ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@item.BorrowDate.ToString("hh:mm tt")</div>
                                </td>
                                <td class="py-3">
                                    @if (item.IsReturned)
                                    {
                                        <div class="fw-semibold text-slate-900 small">@item.ReturnDate!.Value.ToString("MMM dd, yyyy")</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">Returned</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="py-3">
                                    @if (item.IsReturned)
                                    {
                                        <span class="badge bg-emerald-100 text-emerald-800 rounded-pill px-3 py-1">
                                            ● Returned
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="d-inline-flex flex-column gap-1">
                                            <span class="badge bg-amber-100 text-amber-800 rounded-pill px-3 py-1">
                                                ● Borrowed
                                            </span>
                                            <span class="text-muted" style="font-size: 0.75rem;">
                                                @(item.IsOverdue ? "Overdue!" : $"Due in {item.DaysRemaining} days")
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td class="text-end pe-4 py-3">
                                    @if (!item.IsReturned)
                                    {
                                        <form asp-action="Return" asp-route-id="@item.BorrowingId" method="post" class="d-inline" onsubmit="return confirm('Confirm returning this book?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-3 fw-semibold px-3">
                                                Return Book
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <div class="mb-2">
                                    <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-muted opacity-50">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                    </svg>
                                </div>
                                No borrowing records found. <a asp-action="Confirm" class="text-primary fw-medium">Borrow your first book!</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-amber-50 { background-color: #fffbeb; }
    .bg-amber-100 { background-color: #fef3c7; }
    .text-amber-600 { color: #d97706; }
    .text-amber-800 { color: #92400e; }
    .bg-blue-50 { background-color: #eff6ff; }
    .bg-blue-100 { background-color: #dbeafe; }
    .text-blue-600 { color: #2563eb; }
    .text-blue-800 { color: #1e40af; }
    .text-slate-900 { color: #0f172a; }
</style>
