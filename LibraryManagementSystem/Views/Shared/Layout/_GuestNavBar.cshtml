@*

*@
@{
}
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm app-guest-navbar">
    <div class="container">
        @{
            var currentPath = Context.Request.Path.Value?.ToLower() ?? "/";
            Func<string, string> navActive = (string href) =>
            {
                var h = href.ToLower();
                if (h == "/")
                {
                    return (currentPath == "/" || currentPath == "/home" || currentPath == "/home/index") ? "active" : string.Empty;
                }
                if (h == "/about")
                {
                    return (currentPath.Contains("/about")) ? "active" : string.Empty;
                }
                if (h == "/book")
                {
                    return (currentPath.Contains("/book")) ? "active" : string.Empty;
                }
                if (h == "/categories")
                {
                    return (currentPath.Contains("/categor")) ? "active" : string.Empty;
                }
                return currentPath.StartsWith(h) ? "active" : string.Empty;
            };
        }
        <a class="navbar-brand d-flex align-items-center" href="/">
            <div class="brand-logo rounded-3 d-flex align-items-center justify-content-center me-2">
                <img src="~/images/icons/book-open.png" alt="Library logo" width="24" height="24" />
            </div>
            <span class="ms-2 fw-semibold" style="color: #0f172a;">Library Management System</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#guestNavbar" aria-controls="guestNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="guestNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-3">
                <li class="nav-item"><a class="nav-link @navActive("/")" aria-current="page" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link @navActive("/Book")" href="/Book">Books</a></li>
                <li class="nav-item"><a class="nav-link @navActive("/Categories")" href="/Categories">Categories</a></li>
                <li class="nav-item"><a class="nav-link @navActive("/About")" href="/About">About</a></li>
            </ul>

            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-outline-secondary btn-nav-auth" href="/Account/Login">Login</a>
                <a class="btn btn-nav-primary" href="/Account/Register">Register</a>
            </div>
        </div>
    </div>
</nav>
