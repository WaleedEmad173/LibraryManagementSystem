@using LibraryManagementSystem.ViewModels
@model MemberBorrowingsViewModel
@{
    var firstRecord = Model.MatchingRecordCount == 0 ? 0 : (Model.PageNumber - 1) * 8 + 1;
    var lastRecord = Math.Min(Model.PageNumber * 8, Model.MatchingRecordCount);
}

@section Styles {
    <style>
        .my-borrowings-page { color: #17223b; }
        .my-borrowings-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin:0 0 28px; }
        .my-borrowings-heading h1 { margin:0 0 6px; font-size:2.25rem; font-weight:750; letter-spacing:-.045em; }
        .my-borrowings-heading p { margin:0; color:#4f5668; font-size:1rem; }
        .borrowings-live-badge { padding:8px 16px; border-radius:22px; background:#e8ebff; color:#092e80; white-space:nowrap; }
        .borrowings-live-badge i { color:#075c42; margin-right:7px; }
        .borrowings-summary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:28px; margin-bottom:28px; }
        .borrowings-summary-card { position:relative; min-height:220px; overflow:hidden; padding:28px 30px; border-radius:12px; background:#fff; box-shadow:0 2px 8px rgba(22,37,78,.04); }
        .borrowings-summary-card::after { position:absolute; content:""; width:130px; height:130px; right:0; bottom:0; border-radius:22px 0 0 0; opacity:.75; }
        .borrowings-summary-card.due::after { background:#fff3e5; }
        .borrowings-summary-card.total::after { background:#f0f2ff; }
        .borrowings-summary-label { position:relative; z-index:1; color:#4f5668; font-size:1rem; letter-spacing:.06em; }
        .borrowings-summary-icon { position:absolute; z-index:1; right:30px; top:30px; display:grid; width:60px; height:60px; place-items:center; border-radius:10px; background:#fff2e4; color:#966000; font-size:1.45rem; }
        .total .borrowings-summary-icon { background:#e8ebff; color:#092e80; }
        .borrowings-summary-value { position:relative; z-index:1; display:flex; align-items:center; gap:12px; margin-top:8px; font-size:2.5rem; font-weight:750; line-height:1.2; }
        .borrowings-summary-value span { padding:5px 12px; border-radius:18px; background:#ffe2c1; color:#38230c; font-size:.9rem; font-weight:500; }
        .borrowings-summary-value .lifetime { background:#e9edff; color:#092e80; }
        .borrowings-summary-footer { position:absolute; z-index:1; right:30px; bottom:30px; left:30px; display:flex; justify-content:space-between; gap:12px; padding:15px 20px; border-radius:8px; background:#f0f2ff; color:#343c50; }
        .borrowings-summary-footer .due-text { color:#9a6100; }
        .borrowings-summary-footer .good-standing { color:#075c42; }
        .borrowings-summary-footer small { color:#737b8e; }
        .my-borrowings-filter { display:grid; grid-template-columns:1.1fr 1.1fr 1.1fr auto auto; align-items:end; gap:20px; margin-bottom:28px; padding:26px 30px; border-radius:12px; background:#fff; box-shadow:0 2px 8px rgba(22,37,78,.04); }
        .my-borrowings-filter label { display:grid; gap:8px; color:#17223b; font-weight:600; }
        .my-borrowings-filter select,.my-borrowings-filter input { min-width:0; height:52px; padding:0 16px; border:1px solid #edf0fa; border-radius:9px; background:#fff; color:#17223b; }
        .my-borrowings-filter .filter-apply { height:52px; padding:0 28px; border:0; border-radius:9px; background:#233f91; color:#fff; font-weight:600; }
        .my-borrowings-filter .filter-reset { height:52px; display:flex; align-items:center; padding:0 12px; color:#4f5668; text-decoration:none; }
        .my-borrowings-table-card { overflow:hidden; border-radius:12px; background:#fff; box-shadow:0 2px 8px rgba(22,37,78,.04); }
        .my-borrowings-table { width:100%; border-collapse:collapse; }
        .my-borrowings-table th { height:78px; padding:16px 20px; background:#f0f2ff; color:#4f5668; text-align:left; font-size:.83rem; letter-spacing:.04em; }
        .my-borrowings-table td { min-height:120px; padding:20px; border-top:1px solid #f1f2f8; color:#4b5365; vertical-align:middle; }
        .my-borrowings-table tbody tr:nth-child(even) { background:#fafaff; }
        .my-book-cell { display:flex; align-items:center; gap:20px; min-width:280px; }
        .my-book-icon { display:grid; width:50px; height:60px; flex:0 0 50px; place-items:center; border-radius:5px; background:#eef0ff; color:#092e80; font-size:1.35rem; }
        .my-book-title { color:#17223b; font-size:1.35rem; font-weight:700; }
        .my-book-author { margin-top:2px; color:#4f5668; }
        .my-book-meta { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-top:8px; color:#737b8e; font-size:.84rem; }
        .my-book-category { padding:3px 9px; border-radius:14px; background:#e9edff; color:#092e80; }
        .my-date { color:#17223b; font-weight:600; }
        .my-date small { display:block; color:#4f5668; font-weight:400; }
        .my-loan-status { display:inline-block; padding:6px 12px; border-radius:18px; background:#ffe0bd; color:#5e3b0c; white-space:nowrap; }
        .my-loan-status.returned { background:#6ef0bd; color:#064e3b; }
        .my-loan-status.overdue { background:#fee2e2; color:#991b1b; }
        .my-return-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 7px 15px;
            border: 1px solid #059669;
            border-radius: 8px;
            background: #ecfdf5;
            color: #047857;
            font-size: .84rem;
            font-weight: 650;
            line-height: 1.2;
            cursor: pointer;
            box-shadow: 0 1px 3px rgba(4, 120, 87, .12);
            transition: all .15s ease;
        }
        .my-return-btn:hover {
            color: #fff;
            background: #047857;
            border-color: #047857;
            box-shadow: 0 4px 10px rgba(4, 120, 87, .24);
            transform: translateY(-1px);
        }
        .my-borrowings-breadcrumb { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; font-size: 0.88rem; color: #64748b; }
        .my-borrowings-breadcrumb a { color: #64748b; text-decoration: none; }
        .my-borrowings-breadcrumb a:hover { color: #092e80; text-decoration: underline; }
        .my-borrowings-breadcrumb .current { color: #1e293b; font-weight: 600; }
        .my-borrowings-footer { display:flex; align-items:center; justify-content:space-between; gap:16px; min-height:84px; padding:16px 30px; color:#4f5668; }
        .my-borrowings-pages { display:flex; align-items:center; gap:8px; }
        .my-borrowings-pages a,.my-borrowings-pages span { min-width:44px; height:44px; display:grid; place-items:center; padding:0 12px; border-radius:7px; background:#f0f2ff; color:#17223b; text-decoration:none; }
        .my-borrowings-pages .selected { background:#092e80; color:#fff; }
        .my-borrowings-pages .disabled { opacity:.45; pointer-events:none; }
        .my-borrowings-empty { padding:60px 24px; text-align:center; color:#737b8e; }
        @@media(max-width:1100px) { .my-borrowings-filter { grid-template-columns:repeat(2,minmax(0,1fr)); } .borrowings-summary { gap:14px; } }
        @@media(max-width:700px) { .my-borrowings-heading { align-items:flex-start; flex-direction:column; } .my-borrowings-heading h1 { font-size:1.8rem; } .borrowings-summary { grid-template-columns:1fr; } .borrowings-summary-card { min-height:190px; padding:22px; } .borrowings-summary-footer { right:22px; bottom:22px; left:22px; } .my-borrowings-filter { grid-template-columns:1fr; padding:20px; } .my-borrowings-table { min-width:900px; } .my-borrowings-footer { align-items:flex-start; flex-direction:column; padding:16px 20px; } }
    </style>
}

<section class="my-borrowings-page">
    <div class="my-borrowings-breadcrumb">
        <a asp-controller="Book" asp-action="Index">Books</a>
        <span>/</span>
        <span class="current">Confirm Borrowing</span>
    </div>

    <header class="my-borrowings-heading">
        <div>
            <h1>My Borrowings</h1>
            <p>Manage your active book loans, track due dates, and view your complete reading history.</p>
        </div>
        <div class="borrowings-live-badge"><i class="bi bi-circle-fill" aria-hidden="true"></i>Library Desk Circulation Active</div>
    </header>

    <div class="borrowings-summary">
        <article class="borrowings-summary-card due">
            <div class="borrowings-summary-label">CURRENTLY BORROWED</div>
            <div class="borrowings-summary-icon"><i class="bi bi-bookmark" aria-hidden="true"></i></div>
            <div class="borrowings-summary-value">@Model.ActiveBorrowingsCount <span>@Model.ActiveBorrowingsCount active loans</span></div>
            <div class="borrowings-summary-footer">
                @if (Model.NextDueDate.HasValue)
                {
                    var daysUntilDue = (Model.NextDueDate.Value.Date - DateTime.Today).Days;
                    <span class="due-text"><i class="bi bi-clock me-1" aria-hidden="true"></i>@(daysUntilDue < 0 ? $"Next overdue by {Math.Abs(daysUntilDue)} days" : $"Next due in {daysUntilDue} days")</span>
                }
                else
                {
                    <span class="due-text">No active loans</span>
                }
                <small>Ref: ID #MB-@Model.MemberId.ToString("D4")</small>
            </div>
        </article>
        <article class="borrowings-summary-card total">
            <div class="borrowings-summary-label">TOTAL BORROWED</div>
            <div class="borrowings-summary-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></div>
            <div class="borrowings-summary-value">@Model.TotalBorrowedCount <span class="lifetime">Lifetime total</span></div>
            <div class="borrowings-summary-footer">
                <span class="good-standing"><i class="bi bi-patch-check me-1" aria-hidden="true"></i>@(Model.OverdueCount == 0 ? "Account in Good Standing" : $"{Model.OverdueCount} overdue item(s)")</span>
                <small>@Model.OverdueCount Overdue Penalties</small>
            </div>
        </article>
    </div>

    <form method="get" asp-action="Borrow" class="my-borrowings-filter">
        <label>Status
            <select name="status">
                <option value="" selected="@(string.IsNullOrEmpty(Model.StatusFilter))">All Statuses</option>
                <option value="Borrowed" selected="@(Model.StatusFilter == "Borrowed")">Borrowed</option>
                <option value="Returned" selected="@(Model.StatusFilter == "Returned")">Returned</option>
            </select>
        </label>
        <label>From
            <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </label>
        <label>To
            <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </label>
        <button type="submit" class="filter-apply"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Apply</button>
        <a asp-action="Borrow" class="filter-reset">Reset</a>
    </form>

    <div class="my-borrowings-table-card">
        @if (Model.Borrowings.Count == 0)
        {
            <div class="my-borrowings-empty">
                <i class="bi bi-journal-bookmark fs-1" aria-hidden="true"></i>
                <p class="fw-semibold mt-3 mb-1">No borrowing records match these filters.</p>
                <a asp-controller="Book" asp-action="Index">Browse Books</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="my-borrowings-table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">BOOK DETAILS</th>
                            <th scope="col">BORROW<br />DATE</th>
                            <th scope="col">RETURN<br />DATE</th>
                            <th scope="col">STATUS</th>
                            <th scope="col" class="text-center">ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model.Borrowings)
                        {
                            <tr>
                                <td><div class="my-book-cell">
                                    <span class="my-book-icon"><i class="bi bi-book-half" aria-hidden="true"></i></span>
                                    <div>
                                        <a asp-controller="Book" asp-action="Details" asp-route-id="@loan.BookId" class="my-book-title text-decoration-none">@loan.BookTitle</a>
                                        <div class="my-book-author">@loan.BookAuthor</div>
                                        <div class="my-book-meta"><span>ISBN @loan.BookISBN</span><span class="my-book-category">@loan.CategoryName</span></div>
                                    </div>
                                </div></td>
                                <td><div class="my-date">@loan.BorrowDate.ToString("MMM dd, yyyy")<small>@loan.BorrowDate.ToString("hh:mm tt")</small></div></td>
                                <td>
                                    @if (loan.ReturnDate.HasValue)
                                    {
                                        <div class="my-date">@loan.ReturnDate.Value.ToString("MMM dd, yyyy")<small>@loan.ReturnDate.Value.ToString("hh:mm tt")</small></div>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @if (loan.IsReturned)
                                    {
                                        <span class="my-loan-status returned">● Returned</span>
                                    }
                                    else if (loan.IsOverdue)
                                    {
                                        <span class="my-loan-status overdue">● Overdue</span>
                                        <div class="my-loan-note">@loan.DaysOverdue days overdue</div>
                                    }
                                    else
                                    {
                                        <span class="my-loan-status">● Borrowed</span>
                                        <div class="my-loan-note">Due in @loan.DaysRemaining days</div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!loan.IsReturned)
                                    {
                                        <form asp-controller="Member" asp-action="Return" asp-route-id="@loan.BorrowingId" method="post" class="d-inline" onsubmit="return confirm('Confirm returning &quot;@loan.BookTitle&quot;?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="my-return-btn" title="Return this book">
                                                <i class="bi bi-arrow-return-left me-1"></i> Return
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-check2-circle text-success me-1"></i>Returned</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <footer class="my-borrowings-footer">
                <div>Showing <strong>@firstRecord to @lastRecord</strong> of <strong>@Model.MatchingRecordCount</strong> borrowings</div>
                @if (Model.TotalPages > 1)
                {
                    <nav class="my-borrowings-pages" aria-label="Borrowing history pages">
                        <a asp-action="Borrow" asp-route-status="@Model.StatusFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageNumber="@(Model.PageNumber - 1)" class="@(Model.PageNumber == 1 ? "disabled" : "")">‹ Previous</a>
                        @for (var currentPageNumber = 1; currentPageNumber <= Model.TotalPages; currentPageNumber++)
                        {
                            <a asp-action="Borrow" asp-route-status="@Model.StatusFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageNumber="@currentPageNumber" class="@(currentPageNumber == Model.PageNumber ? "selected" : "")">@currentPageNumber</a>
                        }
                        <a asp-action="Borrow" asp-route-status="@Model.StatusFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageNumber="@(Model.PageNumber + 1)" class="@(Model.PageNumber == Model.TotalPages ? "disabled" : "")">Next ›</a>
                    </nav>
                }
            </footer>
        }
    </div>
</section>
