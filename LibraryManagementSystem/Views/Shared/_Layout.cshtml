@using LibraryManagementSystem.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var portalUser = await UserManager.GetUserAsync(User);
    var portalRoles = portalUser == null ? string.Empty : string.Join(", ", await UserManager.GetRolesAsync(portalUser));
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isBorrowPage = currentPage.Equals("/Borrowings/Borrow", StringComparison.OrdinalIgnoreCase);
    var isReturnPage = currentPage.Equals("/Borrowings/Return", StringComparison.OrdinalIgnoreCase);
    var isHistoryPage = currentPage.Equals("/Borrowings/Index", StringComparison.OrdinalIgnoreCase);
    var breadcrumbTitle = isHistoryPage ? "History" : "Portal Overview";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/circulation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryManagementSystem.styles.css" asp-append-version="true" />
</head>
<body class="library-app">
    <aside class="library-sidebar">
        <a class="library-brand" asp-controller="Home" asp-action="Index">
            <span class="library-brand-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="4.8" r="1.6"/><path d="M12 7.2c-2.2-2-5.5-2.5-8-1.3v12.2c2.7-1.2 5.7-.7 8 1.2m0-12.1c2.2-2 5.5-2.5 8-1.3v12.2c-2.7-1.2-5.7-.7-8 1.2m0-12.1v12.1m-4.9-9 2.6.7m7.2-.7-2.6.7" /></svg></span>
            <span><strong>Library System</strong><small>LIBRARIAN PORTAL</small></span>
        </a>
        <nav class="library-nav" aria-label="Main navigation">
            <a asp-controller="Home" asp-action="Index"><span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6"/><rect x="14" y="4" width="6" height="6"/><rect x="4" y="14" width="6" height="6"/><rect x="14" y="14" width="6" height="6"/></svg></span>Dashboard</a>
            <a asp-controller="Home" asp-action="Index"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 5.5c3.4-1.3 6.4-.8 9 1.2 2.6-2 5.6-2.5 9-1.2v13c-3.4-1.3-6.4-.8-9 1.2-2.6-2-5.6-2.5-9-1.2zM12 7v12.7"/></svg></span>Books</a>
            <a asp-controller="Home" asp-action="Index"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 3.2 5.5H8.8L12 3ZM6.8 11h5.5v5.5H6.8zM15 11h5.5v5.5H15zM4 20h16"/></svg></span>Categories</a>
            <a asp-controller="Home" asp-action="Index"><span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-1.5a6 6 0 0 1 12 0V20zm13-9a3 3 0 1 0 0-6m1 9a5 5 0 0 1 4 5"/></svg></span>Members</a>
            <a asp-page="/Borrowings/Borrow" class="@(isBorrowPage ? "active" : "")"><span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 3v18m4-13h3m-3 4h3"/></svg></span>Borrow</a>
            <a asp-page="/Borrowings/Return" class="@(isReturnPage ? "active" : "")"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 14 4 10l5-4M4 10h10a6 6 0 0 1 6 6v2"/></svg></span>Return</a>
            <a asp-page="/Borrowings/Index" class="@(isHistoryPage ? "active" : "")"><span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2M4 5v4h4"/></svg></span>History</a>
        </nav>
        <div class="library-sidebar-footer"><span class="online-dot"></span> Librarian Mode • v1.0</div>
    </aside>
    <div class="library-main">
        <header class="library-topbar">
            <div class="library-breadcrumb"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.2"/></svg> <span>Librarian Portal</span> / <strong>@breadcrumbTitle</strong></div>
            <div class="library-user"><span class="library-user-avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 19a7 7 0 0 1 14 0z"/></svg></span><span><strong>@(portalUser?.FullName ?? portalUser?.UserName)</strong><small>@(portalUser?.UserName ?? "")</small></span><span class="library-role">@portalRoles</span>@if (portalUser != null) { <form asp-controller="Account" asp-action="Logout" method="post"><button class="library-logout" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5v16h5m4-4 4-4-4-4m4 4H9"/></svg> Logout</button></form> }</div>
        </header>
        <main class="library-content" role="main">@RenderBody()</main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
