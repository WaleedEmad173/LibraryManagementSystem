@model Book
@{
    var available = Model.AvailableCopies;
    var total = Model.TotalCopies;
    var pct = total == 0 ? 0 : (int)Math.Round(available * 100.0 / total);

    // out = none left, full = nothing borrowed, low = a third or less left, ok = everything else
    var state = available == 0 ? "out" : available == total ? "full" : pct <= 34 ? "low" : "ok";

    var categoryName = Model.Category?.Name ?? "Uncategorized";
    // "Psychology & Self-Help" -> "psychology-self-help" (used for the chip colour in the CSS)
    var categorySlug = System.Text.RegularExpressions.Regex
        .Replace(categoryName.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');

    var snippet = string.IsNullOrWhiteSpace(Model.Description)
        ? "No description"
        : (Model.Description.Length > 48 ? Model.Description[..48] + "…" : Model.Description);
}

<tr class="@(state == "out" ? "row-out" : "")">
    <td>
        <div class="title-cell">
            <span class="book-icon @(state == "out" ? "book-icon-out" : "")"><i class="bi bi-book"></i></span>
            <div>
                <div class="book-title">@Model.Title</div>
                <div class="book-sub">@snippet</div>
            </div>
        </div>
    </td>
    <td>@Model.Author</td>
    <td class="mono">@Model.ISBN</td>
    <td><span class="chip cat cat-@categorySlug">@categoryName</span></td>
    <td>
        @if (state == "out")
        {
            <div class="copies">
                <span class="bar bar-empty"></span>
                <span class="pill-out">0 / @total</span>
            </div>
        }
        else
        {
            <div class="copies">
                <span class="bar"><span class="bar-fill fill-@state" style="width:@(pct)%"></span></span>
                <span class="count count-@state"><strong>@available</strong> / @total</span>
            </div>
        }
    </td>
    <td class="actions-col">
        <a class="icon-btn" asp-action="Details" asp-route-id="@Model.Id" title="View details"><i class="bi bi-eye"></i></a>
        <a class="icon-btn" asp-action="Edit" asp-route-id="@Model.Id" title="Edit"><i class="bi bi-pencil"></i></a>
        <a class="icon-btn" asp-action="Delete" asp-route-id="@Model.Id" title="Delete"><i class="bi bi-trash3"></i></a>
    </td>
</tr>
