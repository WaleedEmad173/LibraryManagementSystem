@page "/Borrow/{id:int?}"
@model LibraryManagementSystem.Pages.Borrowings.BorrowModel
@{
    ViewData["Title"] = "Borrow a Book for a Member";
    ViewData["Section"] = "Borrow";
    var member = Model.ViewModel.SelectedMember;
    var book = Model.ViewModel.SelectedBook;

    string? ResolveBookImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl)) return null;

        var path = imageUrl.Trim().Replace('\\', '/');
        if (Uri.TryCreate(path, UriKind.Absolute, out _)) return path;
        if (path.StartsWith("~/", StringComparison.Ordinal)) return Url.Content(path);
        if (path.StartsWith("/", StringComparison.Ordinal)) return path;
        if (path.StartsWith("Images/", StringComparison.OrdinalIgnoreCase))
            return Url.Content("~/" + path);

        return Url.Content("~/Images/" + path.TrimStart('/'));
    }
}

<style>
    .circulation-container {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding-bottom: 2.5rem;
    }
    .circulation-container .book-cover-frame {
        width: 100px;
        height: 140px;
        flex: 0 0 100px;
        overflow: hidden;
        border-radius: 6px;
        background: #f0f2ff;
        display: grid;
        place-items: center;
    }
    .circulation-container .book-cover-frame img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .circulation-container .book-cover-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 10px 8px;
        color: #fff;
        text-align: left;
        background: linear-gradient(145deg, #1b4b9e 0%, #0b2d70 62%, #071f52 100%);
        box-shadow: inset 3px 0 0 rgba(255, 255, 255, .2);
    }
    .circulation-container .book-cover-fallback-mark { color: #c9dcff; font-size: .48rem; font-weight: 800; letter-spacing: .16em; }
    .circulation-container .book-cover-fallback-title { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 5; color: #fff; font-size: .75rem; font-weight: 750; line-height: 1.2; overflow-wrap: anywhere; }
    .circulation-container .book-cover-fallback-rule { width: 22px; height: 2px; flex: 0 0 auto; background: #91b5ff; }
    .circulation-container .book-cover-fallback-author { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; color: #d3e0ff; font-size: .59rem; line-height: 1.25; overflow-wrap: anywhere; }
    .circulation-container .date-field-label {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 24px;
    }
    .circulation-container .date-field-period {
        font-size: 0.72rem;
    }
</style>

<div class="circulation-container mt-2">
    <!-- Module Tabs Switcher -->
    <div class="circ-module-tabs">
        <a asp-page="./Borrow" class="circ-tab-btn active">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Borrow a Book
        </a>
        <a asp-page="./Return" class="circ-tab-btn">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
            </svg>
            Return a Book
        </a>
        <a asp-page="./Index" class="circ-tab-btn">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            Circulation History
        </a>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <div class="circ-terminal-badge">CIRCULATION TERMINAL • SESSION ACTIVE</div>
            <h1 class="circ-title">Borrow a Book for a Member</h1>
            <p class="circ-subtitle mb-0">
                Process physical desk checkout and assign book inventory to a registered patron. Loans automatically enforce quota limits and standard duration rules.
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0">
            <div class="circ-stat-chip">
                <div class="circ-stat-chip-icon">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div>
                    <div class="circ-stat-chip-label">SYSTEM DATE</div>
                    <div class="circ-stat-chip-val">@DateTime.Today.ToString("MMM dd, yyyy")</div>
                </div>
            </div>
            <div class="circ-stat-chip">
                <div class="circ-stat-chip-icon" style="color: #10b981;">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <div class="circ-stat-chip-label">TODAY'S CHECKOUTS</div>
                    <div class="circ-stat-chip-val">@Model.ViewModel.TransactedCount Transacted</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Execution Alert Banner -->
    @if (!string.IsNullOrEmpty(Model.ViewModel.AlertState))
    {
        if (Model.ViewModel.AlertState == "success")
        {
            <div class="circ-alert-card circ-alert-success mb-4">
                <div class="circ-alert-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <div class="circ-alert-body">
                    <div class="circ-alert-header">
                        <h4 class="circ-alert-title">@(Model.ViewModel.AlertTitle ?? "Book borrowed successfully")</h4>
                        <span class="circ-badge circ-badge-emerald">SUCCESS</span>
                    </div>
                    <p class="circ-alert-desc">@Model.ViewModel.AlertMessage</p>
                    <div class="circ-alert-footer">
                        <span>Return Due: <strong>@Model.ViewModel.AlertDueDate?.ToString("MMM dd, yyyy")</strong> (14 Day Policy)</span>
                        <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 rounded-2" onclick="window.print()">Print Receipt ↗</button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="circ-alert-card circ-alert-danger mb-4">
                <div class="circ-alert-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div class="circ-alert-body">
                    <div class="circ-alert-header">
                        <h4 class="circ-alert-title">@(Model.ViewModel.AlertTitle ?? "Circulation Transaction Rejected")</h4>
                        <span class="circ-badge circ-badge-rose">REJECTED</span>
                    </div>
                    <p class="circ-alert-desc">@Model.ViewModel.AlertMessage</p>
                </div>
            </div>
        }
    }

    <!-- Main Circulation Form (Full Width to Fill the Entire Space) -->
    <div class="circ-card mb-4">
        <div class="circ-card-header">
            <div>
                <h3 class="circ-card-title">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#1d4ed8">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Issue New Loan / Circulation Desk
                </h3>
                <p class="text-muted small mb-0 mt-1">Complete all fields below confirming physical item handover.</p>
            </div>
            <span class="circ-badge circ-badge-blue">DESK FLOW</span>
        </div>

        <div class="circ-card-body">
            <form id="loanForm" method="post" asp-page-handler="Borrow">
                <div class="row g-4">
                    <!-- Member Field (Column 1) -->
                    <div class="col-md-6">
                        <label class="circ-label" for="memberSelect">
                            <span>Member <span class="text-danger">*</span></span>
                            <span class="circ-hint">Required • ID, email or NFC scan</span>
                        </label>
                        <select id="memberSelect" name="SelectedUserId" class="circ-select" onchange="onMemberChanged(this)" disabled="@(Model.ViewModel.Members.Count == 0)">
                            @foreach (var m in Model.ViewModel.Members)
                            {
                                <option value="@m.Id"
                                        selected="@(m.Id == Model.SelectedUserId)"
                                        data-name="@m.FullName"
                                        data-email="@m.Email"
                                        data-memberid="@m.MemberId"
                                        data-initials="@m.Initials"
                                        data-activeloans="@m.ActiveLoansCount"
                                        data-maxquota="@m.MaxQuota"
                                        data-overdue="@m.OverdueCount"
                                        data-standing="@m.Standing">
                                    @m.FullName - @m.MemberId (@m.Email)
                                </option>
                            }
                        </select>
                        @if (Model.ViewModel.Members.Count == 0) { <div class="circ-hint">No members are recorded in the database.</div> }
                        <div class="d-flex align-items-center justify-content-between mt-2">
                            <span class="circ-badge circ-badge-emerald" id="patronBadgeLabel">
                                <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                </svg>
                                Patron Card Validated <span id="patronBadgeId">@member?.MemberId</span>
                            </span>
                        </div>
                    </div>

                    <!-- Book Field (Column 2) -->
                    <div class="col-md-6">
                        <label class="circ-label" for="bookSelect">
                            <span>Book <span class="text-danger">*</span></span>
                            <span class="circ-hint">Only titles with stock available</span>
                        </label>
                        <select id="bookSelect" name="SelectedBookId" class="circ-select" onchange="onBookChanged(this)" disabled="@(Model.ViewModel.Books.Count == 0)">
                            @foreach (var b in Model.ViewModel.Books)
                            {
                                <option value="@b.Id"
                                        selected="@(b.Id == Model.SelectedBookId)"
                                        data-title="@b.Title"
                                        data-author="@b.Author"
                                        data-isbn="@b.ISBN"
                                        data-category="@b.CategoryName"
                                        data-image-url="@(ResolveBookImageUrl(b.ImageUrl) ?? string.Empty)"
                                        data-total="@b.TotalCopies"
                                        data-available="@b.AvailableCopies"
                                        data-instock="@(b.InStock ? "true" : "false")">
                                    @b.Title (@b.AvailableCopies available of @b.TotalCopies)
                                </option>
                            }
                        </select>
                        @if (Model.ViewModel.Books.Count == 0) { <div class="circ-hint">No books are recorded in the database.</div> }
                        <div class="circ-hint mt-2" id="fieldBookIsbn">ISBN: @book?.ISBN</div>
                    </div>

                    <!-- Borrow Date (Auto-filled) (Column 1) -->
                    <div class="col-md-6">
                        <label class="circ-label date-field-label">
                            <span>Borrow Date (Auto-filled) <span class="text-danger">*</span></span>
                        </label>
                        <input type="text" class="circ-input circ-input-readonly" value="@DateTime.Today.ToString("MMM dd, yyyy")" readonly />
                        <div class="circ-hint mt-1">Not editable during standard circulation checkout.</div>
                    </div>

                    <!-- Calculated Due Date (Column 2) -->
                    <div class="col-md-6">
                        <label class="circ-label date-field-label">
                            <span>Calculated Due Date <span class="text-danger">*</span></span>
                            <span class="circ-badge circ-badge-emerald date-field-period">+14 Days</span>
                        </label>
                        <input type="text" class="circ-input circ-input-readonly" value="@DateTime.Today.AddDays(14).ToString("MMM dd, yyyy")" readonly />
                        <div class="circ-hint mt-1">Standard 14 days - auto-policy applied.</div>
                    </div>

                    <!-- Terms Notice Box (Full Width) -->
                    <div class="col-12">
                        <div class="circ-notice-box">
                            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#2563eb" class="flex-shrink-0 mt-1">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                            <div>
                                <div class="circ-notice-title">Patron circulation notification terms</div>
                                <p class="circ-notice-desc mb-0">
                                    The due date is calculated as <strong>@DateTime.Today.AddDays(14).ToString("MMM dd, yyyy")</strong> using the standard loan duration.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-12">
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-page="./Index" class="circ-btn-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="circ-btn-primary" disabled="@(member == null || book == null || book.AvailableCopies <= 0)">
                                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                </svg>
                                Confirm Borrow
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Live Patron & Book Preview Cards (2-Column Grid Filling Full Width Below) -->
    <div class="row g-4">
        <!-- Left: Patron Circulation Status Card -->
        <div class="col-lg-6">
            <div class="circ-card h-100">
                <div class="circ-card-header py-3">
                    <span class="circ-card-title fs-6">PATRON CIRCULATION STATUS</span>
                    <span class="circ-badge circ-badge-blue" id="previewPatronStatusBadge">@(member == null ? string.Empty : "Member")</span>
                </div>
                <div class="circ-card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="circ-patron-avatar" id="previewAvatar">
                            @member?.Initials
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-slate-900" id="previewPatronName">@member?.FullName</h5>
                            <div class="text-muted small" id="previewPatronEmail">@member?.Email</div>
                            <div class="text-secondary small mt-1">
                                <span id="previewPatronId">ID: @member?.MemberId</span>
                            </div>
                        </div>
                    </div>

                    <!-- Quota Progress -->
                    <div class="mb-3 pt-2 border-top">
                        <div class="d-flex justify-content-between small fw-semibold text-slate-700">
                            <span>Active Loans Quota:</span>
                            <span id="previewQuotaText">@(member?.ActiveLoansCount ?? 0) of @(member?.MaxQuota ?? 3) books checked out</span>
                        </div>
                        <div class="circ-quota-bar">
                            @{
                                var activeCount = member?.ActiveLoansCount ?? 0;
                                var maxQuota = member?.MaxQuota ?? 3;
                                var pct = Math.Min(100, (int)((activeCount / (double)maxQuota) * 100));
                            }
                            <div class="circ-quota-fill" id="previewQuotaFill" style="width: @(pct)%;"></div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mt-1">
                            <span id="previewSlotsRemaining">@(Math.Max(0, maxQuota - activeCount)) slot remaining</span>
                            <span class="text-primary">Quota limit: 3</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <div>
                            <span class="text-muted small">Overdue Items:</span>
                            <strong class="ms-1 small" id="previewOverdue">@(member?.OverdueCount ?? 0) Items</strong>
                        </div>
                        <span class="circ-badge circ-badge-blue" id="previewStanding">
                            @member?.Standing
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Selected Book Inventory Card -->
        <div class="col-lg-6">
            <div class="circ-card h-100">
                <div class="circ-card-header py-3">
                    <span class="circ-card-title fs-6">SELECTED BOOK INVENTORY</span>
                    <span class="circ-badge @(book == null ? "circ-badge-blue" : book.InStock ? "circ-badge-emerald" : "circ-badge-rose")" id="previewBookStockBadge">
                        @(book == null ? string.Empty : book.InStock ? "• In Stock" : "• Out of Stock")
                    </span>
                </div>
                <div class="circ-card-body">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="book-cover-frame flex-shrink-0">
                            @if (!string.IsNullOrWhiteSpace(book?.ImageUrl))
                            {
                                <img id="previewBookCover" src="@ResolveBookImageUrl(book.ImageUrl)" alt="@book.Title" onerror="showBookCoverFallback()" />
                            }
                            else
                            {
                                <img id="previewBookCover" class="d-none" alt="" />
                            }
                            <div id="previewBookCoverEmpty" class="book-cover-fallback @(string.IsNullOrWhiteSpace(book?.ImageUrl) ? string.Empty : "d-none")">
                                <span class="book-cover-fallback-mark">LIBRARY</span>
                                <span id="previewBookCoverFallbackTitle" class="book-cover-fallback-title">@(book?.Title ?? "Select a book")</span>
                                <span class="book-cover-fallback-rule"></span>
                                <span id="previewBookCoverFallbackAuthor" class="book-cover-fallback-author">@(book?.Author ?? string.Empty)</span>
                            </div>
                        </div>
                        <div>
                            <span class="badge bg-light text-primary border mb-1" id="previewCategory">@book?.CategoryName</span>
                            <h6 class="fw-bold mb-1 text-slate-900" id="previewBookTitle">@book?.Title</h6>
                            <div class="text-muted small" id="previewBookAuthor">@book?.Author</div>
                            <div class="text-secondary small mt-1" id="previewBookIsbn">@book?.ISBN</div>
                        </div>
                    </div>

                    <!-- 3-Metrics Grid -->
                    <div class="circ-book-metrics-grid">
                        <div>
                            <div class="circ-book-metric-val" id="metricTotal">@(book?.TotalCopies ?? 0)</div>
                            <div class="circ-book-metric-label">Total Catalog</div>
                        </div>
                        <div>
                            <div class="circ-book-metric-val text-success" id="metricAvailable">@(book?.AvailableCopies ?? 0)</div>
                            <div class="circ-book-metric-label">Available Shelf</div>
                        </div>
                        <div>
                            <div class="circ-book-metric-val text-primary" id="metricActiveLoan">@(book?.ActiveLoans ?? 0)</div>
                            <div class="circ-book-metric-label">In Active Loan</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onMemberChanged(select) {
            const opt = select.options[select.selectedIndex];
            if (!opt) return;

            const name = opt.getAttribute('data-name');
            const email = opt.getAttribute('data-email');
            const memberId = opt.getAttribute('data-memberid');
            const initials = opt.getAttribute('data-initials');
            const activeLoans = parseInt(opt.getAttribute('data-activeloans') || '0');
            const maxQuota = parseInt(opt.getAttribute('data-maxquota') || '3');
            const overdue = opt.getAttribute('data-overdue') || '0';
            const standing = opt.getAttribute('data-standing') || '';

            document.getElementById('previewPatronName').innerText = name;
            document.getElementById('previewPatronEmail').innerText = email;
            document.getElementById('previewPatronId').innerText = 'ID: ' + memberId;
            document.getElementById('previewAvatar').innerText = initials;
            document.getElementById('patronBadgeId').innerText = memberId;

            document.getElementById('previewQuotaText').innerText = `${activeLoans} of ${maxQuota} books checked out`;
            const pct = Math.min(100, Math.round((activeLoans / maxQuota) * 100));
            document.getElementById('previewQuotaFill').style.width = pct + '%';
            document.getElementById('previewSlotsRemaining').innerText = `${Math.max(0, maxQuota - activeLoans)} slot remaining`;
            document.getElementById('previewOverdue').innerText = `${overdue} Items`;
            document.getElementById('previewStanding').innerText = standing;
        }

        function onBookChanged(select) {
            const opt = select.options[select.selectedIndex];
            if (!opt) return;

            const title = opt.getAttribute('data-title');
            const author = opt.getAttribute('data-author');
            const isbn = opt.getAttribute('data-isbn');
            const category = opt.getAttribute('data-category');
            const imageUrl = opt.getAttribute('data-image-url');
            const total = parseInt(opt.getAttribute('data-total') || '0');
            const available = parseInt(opt.getAttribute('data-available') || '0');
            const inStock = opt.getAttribute('data-instock') === 'true';

            document.getElementById('previewBookTitle').innerText = title;
            document.getElementById('previewBookAuthor').innerText = author;
            document.getElementById('previewBookIsbn').innerText = isbn;
            const fieldIsbn = document.getElementById('fieldBookIsbn');
            if (fieldIsbn) fieldIsbn.innerText = 'ISBN: ' + isbn;
            document.getElementById('previewCategory').innerText = category;
            document.getElementById('previewBookCoverFallbackTitle').innerText = title;
            document.getElementById('previewBookCoverFallbackAuthor').innerText = author;
            const cover = document.getElementById('previewBookCover');
            const emptyCover = document.getElementById('previewBookCoverEmpty');
            if (imageUrl) {
                cover.src = imageUrl;
                cover.alt = 'Cover of ' + title;
                cover.classList.remove('d-none');
                if (emptyCover) emptyCover.classList.add('d-none');
            } else {
                cover.removeAttribute('src');
                cover.classList.add('d-none');
                if (emptyCover) emptyCover.classList.remove('d-none');
            }
            document.getElementById('metricTotal').innerText = total;
            document.getElementById('metricAvailable').innerText = available;
            document.getElementById('metricActiveLoan').innerText = Math.max(0, total - available);

            const stockBadge = document.getElementById('previewBookStockBadge');
            if (inStock) {
                stockBadge.className = 'circ-badge circ-badge-emerald';
                stockBadge.innerText = '• In Stock';
            } else {
                stockBadge.className = 'circ-badge circ-badge-rose';
                stockBadge.innerText = '• Out of Stock';
            }
        }

        function showBookCoverFallback() {
            const cover = document.getElementById('previewBookCover');
            const fallback = document.getElementById('previewBookCoverEmpty');
            if (cover) cover.classList.add('d-none');
            if (fallback) fallback.classList.remove('d-none');
        }
    </script>
}
