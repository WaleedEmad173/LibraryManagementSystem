@model LibraryManagementSystem.ViewModels.GuestHomeViewModel
@{
    ViewData["Title"] = "Discover Your Next Great Read";
}

<div class="guest-home-container py-4">
    <!-- Hero Section -->
    <section class="hero-section text-center py-4">
        <div class="announcement-pill mb-3">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>@(Model.TotalTitles > 0 ? $"{Model.TotalTitles:N0} Books in Catalog" : "Explore Library Catalog") &amp; @(Model.TotalCategories > 0 ? $"{Model.TotalCategories} Categories" : "Multiple Categories")</span>
        </div>

        <h1 class="hero-headline">Find your next great read</h1>
        <p class="hero-subtitle">
            Explore thousands of books, academic journals, and digital audiobooks across diverse genres. Search our unified catalog or visit our modern branch locations today.
        </p>

        <!-- Search Bar -->
        <form asp-controller="Book" asp-action="Index" method="get" class="search-bar-form mt-4">
            <div class="search-input-wrapper">
                <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" name="search" class="search-input" placeholder="Search by title, author, ISBN, or topic..." />
            </div>

            <div class="category-dropdown-wrapper">
                <select name="categoryId" class="category-select">
                    <option value="">All Categories</option>
                    @if (Model.Categories != null && Model.Categories.Any())
                    {
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>

            <button type="submit" class="btn-search-submit">
                <span>Search</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>

        <!-- Topic Pills -->
        <div class="topic-pills-row mt-3">
            <a asp-controller="Book" asp-action="Index" class="topic-pill active">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                    <path d="M6 6h10"></path>
                    <path d="M6 10h10"></path>
                </svg>
                <span>Browse All</span>
            </a>
            @if (Model.Categories != null && Model.Categories.Any())
            {
                foreach (var cat in Model.Categories.Take(6))
                {
                    <a asp-controller="Book" asp-action="Index" asp-route-categoryId="@cat.Id" class="topic-pill">
                        @cat.Name
                    </a>
                }
            }
        </div>
    </section>

    <!-- Key Stats 4-Grid Bar -->
    <section class="stats-grid-section my-5">
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="stat-box-card">
                    <div class="stat-box-icon text-primary bg-primary-soft">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                            <line x1="2" y1="10" x2="22" y2="10"></line>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-number">@Model.TotalTitles.ToString("N0")</div>
                        <div class="stat-label">Total Books in Catalog</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="stat-box-card">
                    <div class="stat-box-icon text-amber bg-amber-soft">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-number">@Model.TotalMembers.ToString("N0")</div>
                        <div class="stat-label">Registered Members</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="stat-box-card">
                    <div class="stat-box-icon text-success bg-success-soft">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-number">@Model.AvailableCopies.ToString("N0")</div>
                        <div class="stat-label">Copies Available on Shelf</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="stat-box-card">
                    <div class="stat-box-icon text-indigo bg-indigo-soft">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-number">@Model.TotalBorrowings.ToString("N0")</div>
                        <div class="stat-label">Total Loan Operations</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Books Section -->
    <section class="featured-books-section my-5">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <span class="spotlight-tag">#CATALOG SPOTLIGHT</span>
                <h2 class="featured-heading">Featured Books</h2>
                <p class="featured-sub mb-0">Popular titles and top loaned editions directly from our library database.</p>
            </div>
            <a asp-controller="Book" asp-action="Index" class="view-all-link">
                <span>View all titles</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.FeaturedBooks != null && Model.FeaturedBooks.Any())
            {
                foreach (var book in Model.FeaturedBooks)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="book-card-item">
                            <!-- Book Cover Graphic -->
                            <div class="book-cover-banner" style="background: @book.BgGradient; position: relative; overflow: hidden;">
                                @if (!string.IsNullOrEmpty(book.ImageUrl))
                                {
                                    <img src="~/Images/@book.ImageUrl" alt="@book.Title" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35;" />
                                }
                                <div class="d-flex justify-content-between align-items-center mb-3 position-relative" style="z-index: 2;">
                                    @if (book.IsAvailable)
                                    {
                                        <span class="badge-available">
                                            <span class="pulse-dot"></span> Available (@book.AvailableCopies)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-available" style="background: rgba(239, 68, 68, 0.25); color: #fca5a5; border-color: rgba(239, 68, 68, 0.5);">
                                            <span class="pulse-dot" style="background: #ef4444; box-shadow: 0 0 6px #ef4444;"></span> Loaned Out
                                        </span>
                                    }
                                    <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" class="btn-bookmark" title="View details">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
                                        </svg>
                                    </a>
                                </div>

                                <div class="cover-meta-tag position-relative" style="z-index: 2;">@book.CategoryName</div>
                                <h4 class="cover-title position-relative text-truncate" style="z-index: 2;" title="@book.Title">@book.Title</h4>
                                <div class="cover-author position-relative text-truncate" style="z-index: 2;">@book.Author</div>
                            </div>

                            <!-- Card Body Details -->
                            <div class="book-card-details">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="category-pill-badge">@book.CategoryName</span>
                                    <span class="publisher-meta">@book.PublisherYear</span>
                                </div>

                                <h5 class="book-info-title text-truncate" title="@book.Title">@book.Title</h5>
                                <div class="book-info-author text-truncate">@book.Author</div>

                                <div class="rating-row mt-2">
                                    <span class="stars">★ @book.Rating.ToString("F1")</span>
                                    <span class="reviews-count">(@book.ReviewCount loans &amp; reviews)</span>
                                </div>

                                <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-custom w-100 mt-3">
                                    <span>View Details</span>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">No books currently recorded in catalog.</p>
                    <a asp-controller="Book" asp-action="Index" class="btn btn-primary-dash">Browse Catalog</a>
                </div>
            }
        </div>
    </section>

    <!-- Sanctuary / Facilities Section -->
    <section class="sanctuary-section my-5">
        <div class="sanctuary-card">
            <div class="row g-0 align-items-stretch">
                <!-- Left Photo -->
                <div class="col-lg-5 position-relative sanctuary-img-col">
                    <img src="~/Images/library-hall.jpg" alt="University Library Modern Study Hall" class="sanctuary-img" />
                    <div class="branch-pill-overlay">
                        <span>Central Branch • Floor 2</span>
                    </div>
                </div>

                <!-- Right Information -->
                <div class="col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center">
                    <div class="architectural-tag mb-2">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                            <path d="M3 21h18"></path>
                            <path d="M9 8h1"></path>
                            <path d="M9 12h1"></path>
                            <path d="M9 16h1"></path>
                            <path d="M14 8h1"></path>
                            <path d="M14 12h1"></path>
                            <path d="M14 16h1"></path>
                            <path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path>
                        </svg>
                        <span>Architectural Spaces</span>
                    </div>

                    <h2 class="sanctuary-title">A quiet sanctuary engineered for deep research and discovery</h2>
                    <p class="sanctuary-desc">
                        Whether you need an individual carrel for focused writes, collaborative media dens, or high-resolution scanning suites, our branches offer spaces tailored to modern scholars.
                    </p>

                    <div class="row g-3 my-2">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-start gap-2">
                                <div class="amenity-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
                                        <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
                                        <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
                                        <line x1="12" y1="20" x2="12.01" y2="20"></line>
                                    </svg>
                                </div>
                                <div>
                                    <div class="amenity-name">Gigabit Research Wi-Fi</div>
                                    <div class="amenity-desc">Seamless encrypted connection campus-wide</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="d-flex align-items-start gap-2">
                                <div class="amenity-icon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                                        <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <div class="amenity-name">Audiobook Listening Pods</div>
                                    <div class="amenity-desc">Dedicated spatial listening acoustics</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-3 mt-4 pt-2">
                        <a asp-controller="Book" asp-action="Index" class="btn btn-primary-auth py-2 px-3">
                            <span>Explore Branch Amenities</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                        <span class="hours-text">Open Mon-Sun 7:00 AM - 11:00 PM</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How Our Library Works -->
    <section class="how-it-works-section my-5 text-center">
        <h2 class="how-title">How Our Library Works</h2>
        <p class="how-subtitle">Experience a streamlined borrowing system built for research speed, digital nobility, and convenience.</p>

        <div class="row g-4 mt-2 text-start">
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-icon-box text-primary bg-primary-soft mb-3">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                            <path d="M7 15h0M2 9.5h20"></path>
                        </svg>
                    </div>
                    <div class="step-tag">STEP 01</div>
                    <h4 class="step-title">Browse & Reserve</h4>
                    <p class="step-desc">
                        Search from our online Catalog, explore open shelves, and place reservations on print or digital editions with a single click.
                    </p>
                    <a asp-controller="Book" asp-action="Index" class="step-link">
                        <span>View availability guidelines</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-icon-box text-amber bg-amber-soft mb-3">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="5" height="5" x="3" y="3" rx="1"></rect>
                            <rect width="5" height="5" x="16" y="3" rx="1"></rect>
                            <rect width="5" height="5" x="3" y="16" rx="1"></rect>
                            <path d="M21 16h-3a2 2 0 0 0-2 2v3"></path>
                            <path d="M21 21v.01"></path>
                            <path d="M12 7v3a2 2 0 0 1-2 2H7"></path>
                            <path d="M3 12h.01"></path>
                            <path d="M12 3h.01"></path>
                            <path d="M12 16v.01"></path>
                            <path d="M16 12h1"></path>
                            <path d="M21 12v.01"></path>
                            <path d="M12 21v-1"></path>
                        </svg>
                    </div>
                    <div class="step-tag">STEP 02</div>
                    <h4 class="step-title">Instant Borrowing</h4>
                    <p class="step-desc">
                        Pick up loans from automated lockers or scan book barcodes on self-checkout tablets using your mobile member QR card.
                    </p>
                    <a asp-controller="Account" asp-action="Login" class="step-link">
                        <span>Learn self-pickup steps</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-icon-box text-success bg-success-soft mb-3">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="14" x="2" y="3" rx="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                    <div class="step-tag">STEP 03</div>
                    <h4 class="step-title">Free Digital Access</h4>
                    <p class="step-desc">
                        Enjoy unlimited access to audiobooks, journals, and peer-reviewed papers on your laptop, e-reader, or smartphone anytime.
                    </p>
                    <a asp-controller="Book" asp-action="Index" class="step-link">
                        <span>Read on more devices now</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action Banner -->
    <section class="cta-banner my-5">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
            <div>
                <h3 class="cta-title">Ready to start exploring @(Model.TotalTitles > 0 ? $"{Model.TotalTitles:N0}+" : "our catalog") titles?</h3>
                <p class="cta-sub mb-0">Membership is completely free for all active students and accredited university researchers. Get approved in under 2 minutes.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Account" asp-action="Register" class="btn btn-warning-custom">
                    <span>Register for Free</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                    </svg>
                </a>
                <a asp-controller="Book" asp-action="Index" class="btn btn-outline-white">Borrowing Rules</a>
            </div>
        </div>
    </section>
</div>
