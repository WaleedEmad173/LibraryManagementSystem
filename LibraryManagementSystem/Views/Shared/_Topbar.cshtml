@{
    var isAdmin = User.IsInRole("Admin");
    var sectionTitle = ViewData["Section"]?.ToString() ?? (isAdmin ? "Overview" : "Books");
    var portalName = isAdmin ? "Admin Portal" : "Librarian Portal";
    var userName = User.Identity?.Name ?? (isAdmin ? "Mona Ali" : "Omar Hassan");
    
    // Extract 2 initials from username/email
    var parts = userName.Split(new[] { ' ', '.', '@', '_' }, StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
        : (parts.Length == 1 && parts[0].Length >= 2 ? parts[0][..2].ToUpper() : (isAdmin ? "MA" : "OH"));
}
<header class="topbar">
    <div class="crumbs" style="display: flex; align-items: center; gap: 4px;">
        @if (isAdmin)
        {
            <i class="bi bi-shield-lock me-1" style="color: var(--muted); font-size: 14px;"></i>
        }
        <span>@portalName</span> <span style="margin: 0 4px;">/</span> <strong>@sectionTitle</strong>
    </div>

    <div class="topbar-right">
        <div class="user">
            <div class="avatar" style="font-weight: 700; font-size: 13px; letter-spacing: 0.5px;">
                @initials
            </div>
            <div class="user-meta" style="display: flex; flex-direction: column; line-height: 1.2;">
                <div class="user-name" style="display: flex; align-items: center; gap: 8px;">
                    <span>@userName</span>
                    @if (isAdmin)
                    {
                        <span class="chip" style="font-size: 11px; padding: 2px 8px; border-radius: 99px; background: #fee2e2; color: #dc2626; font-weight: 600;">Admin</span>
                    }
                    else
                    {
                        <span class="chip chip-soft" style="font-size: 11px; padding: 2px 8px; border-radius: 99px;">Librarian</span>
                    }
                </div>
                <span class="user-sub" style="font-size: 11px; color: var(--muted); font-weight: 500;">@(isAdmin ? "#ADM-001" : "LIB-104")</span>
            </div>
        </div>

        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-ghost"><i class="bi bi-box-arrow-right"></i> Logout</button>
        </form>
    </div>
</header>
