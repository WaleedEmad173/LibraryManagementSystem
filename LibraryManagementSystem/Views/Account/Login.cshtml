@model LibraryManagementSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex flex-column justify-content-center align-items-center py-5 min-vh-75">
    <!-- Login Card -->
    <div class="auth-card card border-0 shadow-sm rounded-4 p-4 p-sm-5" style="width: 100%; max-width: 480px; background: #ffffff;">
        <div class="text-center mb-4">
            <!-- Logo Icon Box -->
            <div class="auth-logo-box mx-auto mb-2">
                <img src="~/Images/icons/Logo.svg" alt="Academic Portal" width="22" height="22" />
            </div>
            
            <div class="auth-portal-tag">ACADEMIC PORTAL</div>
            <h2 class="auth-title">Welcome back</h2>
            <p class="auth-subtitle">Sign in to access your library account, borrowed books, and reservations.</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="auth-alert-error alert alert-dismissible fade show d-flex align-items-center justify-content-between mb-4" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    </svg>
                    <span>@Html.ValidationSummary(true, "", new { @class = "text-danger m-0 list-unstyled" })</span>
                </div>
                <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="Login" method="post">
            <!-- Email Input -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label auth-label">Email address <span class="text-danger">*</span></label>
                <div class="input-group-custom">
                    <span class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                    </span>
                    <input asp-for="Email" class="form-control auth-input" placeholder="m.kleppmann@academic.edu" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Password Input -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Password" class="form-label auth-label mb-0">Password <span class="text-danger">*</span></label>
                    <a asp-action="ForgotPassword" class="forgot-password-link">Forgot password?</a>
                </div>
                <div class="input-group-custom">
                    <span class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </span>
                    <input asp-for="Password" id="passwordInput" class="form-control auth-input" placeholder="••••••••••••" />
                    <button type="button" class="input-action-btn" onclick="togglePasswordVisibility()" title="Toggle password">
                        <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Remember Me -->
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input auth-checkbox" id="rememberMeCheck" />
                <label class="form-check-label auth-checkbox-label" for="rememberMeCheck">
                    Remember me for 30 days
                </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary-auth w-100 mb-3">
                <span>Sign In</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>

        <!-- Register Link Box -->
        <div class="auth-register-box text-center">
            <span>Don't have an account?</span>
            <a asp-action="Register" class="register-link">Register</a>
        </div>
    </div>

    <!-- Encrypted Footer Note -->
    <div class="auth-footer-note mt-3">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
        </svg>
        <span>256-Bit Encrypted Academic Network Access</span>
    </div>
</div>

<style>
    .auth-card {
        border-radius: 16px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    }

    .auth-logo-box {
        width: 44px;
        height: 44px;
        background-color: #eff6ff;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-portal-tag {
        font-size: 0.72rem;
        font-weight: 700;
        color: #64748b;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-top: 10px;
    }

    .auth-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0f172a;
        margin-top: 2px;
        margin-bottom: 6px;
    }

    .auth-subtitle {
        font-size: 0.85rem;
        color: #64748b;
        margin-bottom: 0;
        line-height: 1.4;
    }

    .auth-alert-error {
        background-color: #fee2e2;
        border: 1px solid #fecaca;
        color: #991b1b;
        border-radius: 8px;
        font-size: 0.85rem;
        padding: 10px 14px;
    }

    .auth-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .input-group-custom {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 5;
    }

    .auth-input {
        padding: 10px 40px 10px 42px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        font-size: 0.9rem;
        color: #0f172a;
        background-color: #ffffff;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .auth-input:focus {
        border-color: #1e3a8a;
        box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.12);
        outline: none;
    }

    .input-action-btn {
        position: absolute;
        right: 12px;
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 5;
    }

    .input-action-btn:hover {
        color: #475569;
    }

    .forgot-password-link {
        font-size: 0.8rem;
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
    }

    .forgot-password-link:hover {
        text-decoration: underline;
        color: #1d4ed8;
    }

    .auth-checkbox {
        width: 16px;
        height: 16px;
        border-radius: 4px;
        border: 1px solid #cbd5e1;
        cursor: pointer;
    }

    .auth-checkbox:checked {
        background-color: #1e3a8a;
        border-color: #1e3a8a;
    }

    .auth-checkbox-label {
        font-size: 0.84rem;
        color: #334155;
        cursor: pointer;
        user-select: none;
    }

    .btn-primary-auth {
        background-color: #1e3a8a;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 11px 16px;
        font-size: 0.92rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background-color 0.15s ease, transform 0.05s ease;
    }

    .btn-primary-auth:hover {
        background-color: #172554;
        color: #ffffff;
    }

    .btn-primary-auth:active {
        transform: scale(0.99);
    }

    .auth-register-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 11px 14px;
        font-size: 0.85rem;
        color: #475569;
    }

    .register-link {
        color: #1e3a8a;
        font-weight: 600;
        text-decoration: none;
        margin-left: 4px;
    }

    .register-link:hover {
        text-decoration: underline;
    }

    .auth-footer-note {
        font-size: 0.72rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<script>
    function togglePasswordVisibility() {
        var input = document.getElementById("passwordInput");
        if (input.type === "password") {
            input.type = "text";
        } else {
            input.type = "password";
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
