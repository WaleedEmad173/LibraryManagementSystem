@model RegisterViewModel
@{
    Layout = null; // standalone page, same as Login
    ViewData["Title"] = "Create account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Library System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/library.css" asp-append-version="true" />
    <style>
        .auth-page { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
        .auth-aside { background: var(--navy); color: #cfd8ff; padding: 48px; display: flex; flex-direction: column; justify-content: space-between; }
        .auth-aside .brand { margin-bottom: 0; }
        .auth-aside h2 { color: #fff; font-size: 30px; font-weight: 800; line-height: 1.2; max-width: 14ch; }
        .auth-aside p { margin-top: 12px; max-width: 34ch; color: #b8c4ff; }
        .auth-main { display: grid; place-items: center; padding: 32px; }
        .auth-card { width: 100%; max-width: 420px; }
        .auth-card h1 { margin-bottom: 4px; }
        .auth-card .field { margin-top: 18px; }
        .auth-card .btn { width: 100%; justify-content: center; margin-top: 22px; padding: 12px 16px; }
        .auth-foot { margin-top: 20px; text-align: center; color: var(--muted); }
        .auth-foot a { color: var(--navy); font-weight: 600; }
        @@media (max-width: 800px) { .auth-page { grid-template-columns: 1fr; } .auth-aside { display: none; } }
    </style>
</head>
<body>
    <div class="auth-page">
        <aside class="auth-aside">
            <div class="brand">
                <span class="brand-logo"><i class="bi bi-journal-bookmark"></i></span>
                <div>
                    <div class="brand-name">Library System</div>
                    <div class="brand-sub">LIBRARIAN PORTAL</div>
                </div>
            </div>
            <div>
                <h2>Join the library in a minute.</h2>
                <p>Create a member account to browse the catalog and keep track of your borrowed books.</p>
            </div>
        </aside>

        <main class="auth-main">
            <section class="card auth-card accent-navy">
                <h1>Create your account</h1>
                <p class="muted">Fill in your details to register as a member.</p>

                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-error" style="margin:16px 0 0"></div>

                    <div class="field">
                        <label asp-for="FullName">Full name</label>
                        <input asp-for="FullName" autocomplete="name" autofocus />
                        <span asp-validation-for="FullName" class="field-validation-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" autocomplete="username" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password">Password <span class="label-note">At least 6 characters, including a number</span></label>
                        <input asp-for="Password" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="ConfirmPassword">Confirm password</label>
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Create account</button>
                </form>

                <p class="auth-foot">Already registered? <a asp-action="Login">Sign in</a></p>
            </section>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
