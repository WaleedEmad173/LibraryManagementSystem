@{
    ViewData["Title"] = "Check Your Email";
}

<div class="d-flex flex-column justify-content-center align-items-center py-5 min-vh-75">
    <div class="auth-card card border-0 shadow-sm rounded-4 p-4 p-sm-5 text-center" style="width: 100%; max-width: 480px; background: #ffffff;">
        <!-- Success Icon -->
        <div class="success-icon-box mx-auto mb-3">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>

        <div class="auth-portal-tag">ACADEMIC PORTAL</div>
        <h2 class="auth-title">Check your email</h2>
        <p class="auth-subtitle mb-4">
            If an account exists for that email address, we have sent instructions to reset your password.
        </p>

        <a asp-action="Login" class="btn btn-primary-auth w-100 mb-3 text-decoration-none">
            <span>Back to Sign In</span>
        </a>
    </div>

    <!-- Encrypted Footer Note -->
    <div class="auth-footer-note mt-3">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
        </svg>
        <span>256-Bit Encrypted Academic Network Access</span>
    </div>
</div>

<style>
    .auth-card {
        border-radius: 16px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    }

    .success-icon-box {
        width: 52px;
        height: 52px;
        background-color: #dcfce7;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-portal-tag {
        font-size: 0.72rem;
        font-weight: 700;
        color: #64748b;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-top: 4px;
    }

    .auth-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0f172a;
        margin-top: 2px;
        margin-bottom: 6px;
    }

    .auth-subtitle {
        font-size: 0.85rem;
        color: #64748b;
        line-height: 1.5;
    }

    .btn-primary-auth {
        background-color: #1e3a8a;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 11px 16px;
        font-size: 0.92rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background-color 0.15s ease;
    }

    .btn-primary-auth:hover {
        background-color: #172554;
        color: #ffffff;
    }

    .auth-footer-note {
        font-size: 0.72rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
