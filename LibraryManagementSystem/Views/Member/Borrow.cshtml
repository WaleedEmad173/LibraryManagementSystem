@using LibraryManagementSystem.ViewModels
@model MemberBorrowingsViewModel
@{
    ViewData["Title"] = "My Borrowings";
    ViewData["Section"] = "Confirm Borrowing";
    var firstRecord = Model.MatchingRecordCount == 0 ? 0 : (Model.PageNumber - 1) * 8 + 1;
    var lastRecord = Math.Min(Model.PageNumber * 8, Model.MatchingRecordCount);
}

@section Styles {
    <style>
        .content:has(.my-borrowings-container) {
            box-sizing: border-box;
            min-height: calc(100vh - 64px);
            padding-left: 16px;
            padding-right: 16px;
        }

        .my-borrowings-container {
            color: #0f172a;
            width: 100%;
            max-width: none;
            min-width: 0;
            flex: 1 0 auto;
            margin: 0;
            box-sizing: border-box;
        }

        /* Top Page Header */
        .borrowings-page-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
        }
        .borrowings-page-header h1 {
            font-size: 1.85rem;
            font-weight: 750;
            color: #0f172a;
            letter-spacing: -0.025em;
            margin: 0 0 6px 0;
            line-height: 1.2;
        }
        .borrowings-page-header p {
            color: #64748b;
            font-size: 0.88rem;
            margin: 0;
            line-height: 1.4;
        }
        .borrowings-desk-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 14px;
            border-radius: 9999px;
            background: #eff6ff;
            color: #1e40af;
            font-size: 0.78rem;
            font-weight: 600;
            white-space: nowrap;
            border: 1px solid #dbeafe;
        }
        .borrowings-desk-badge .status-indicator-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #2563eb;
            display: inline-block;
            box-shadow: 0 0 6px rgba(37, 99, 235, 0.6);
        }

        /* Top Metric Cards (Side by Side) */
        .borrowings-metric-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
            margin-bottom: 22px;
        }
        .borrowings-stat-card {
            background: #ffffff;
            border: 1px solid #f1f5f9;
            border-radius: 12px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
            padding: 22px 24px 18px 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .stat-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
        }
        .stat-card-label {
            font-size: 0.72rem;
            font-weight: 700;
            color: #64748b;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        .stat-card-icon-box {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }
        .stat-card-icon-box.peach {
            background: #fff7ed;
            color: #ea580c;
        }
        .stat-card-icon-box.blue {
            background: #eff6ff;
            color: #2563eb;
        }
        .stat-card-number-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
        }
        .stat-card-number {
            font-size: 2.25rem;
            font-weight: 800;
            color: #0f172a;
            line-height: 1;
        }
        .stat-card-pill {
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        .stat-card-pill.amber {
            background: #fef3c7;
            color: #b45309;
        }
        .stat-card-pill.blue {
            background: #eff6ff;
            color: #1d4ed8;
        }
        .stat-card-footer {
            border-radius: 8px;
            padding: 9px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.78rem;
        }
        .stat-card-footer.peach-subtle {
            background: #fffaf5;
            border: 1px solid #fed7aa;
        }
        .stat-card-footer.blue-subtle {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
        }
        .stat-card-footer .footer-highlight-amber {
            color: #b45309;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .stat-card-footer .footer-highlight-green {
            color: #0f172a;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .stat-card-footer .footer-meta-id {
            color: #94a3b8;
            font-size: 0.75rem;
            font-weight: 500;
        }

        /* Filter Section */
        .borrowings-filter-card {
            background: #ffffff;
            border: 1px solid #f1f5f9;
            border-radius: 12px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
            padding: 16px 24px;
            margin-bottom: 22px;
        }
        .borrowings-filter-form {
            display: flex;
            align-items: flex-end;
            gap: 16px;
            flex-wrap: wrap;
        }
        .filter-field-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .filter-field-group label {
            font-size: 0.78rem;
            font-weight: 600;
            color: #334155;
            margin: 0;
        }
        .filter-input,
        .filter-select {
            height: 40px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 0 12px;
            background: #ffffff;
            font-size: 0.84rem;
            color: #0f172a;
            min-width: 170px;
            outline: none;
            transition: border-color 0.15s ease;
        }
        .filter-input:focus,
        .filter-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
        }
        .filter-buttons-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-left: auto;
        }
        .btn-filter-apply {
            height: 40px;
            padding: 0 22px;
            border-radius: 8px;
            background: #1e3a8a;
            color: #ffffff;
            font-size: 0.84rem;
            font-weight: 600;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }
        .btn-filter-apply:hover {
            background: #172554;
        }
        .btn-filter-reset {
            height: 40px;
            display: inline-flex;
            align-items: center;
            padding: 0 10px;
            color: #64748b;
            font-size: 0.84rem;
            font-weight: 500;
            text-decoration: none;
            transition: color 0.15s ease;
        }
        .btn-filter-reset:hover {
            color: #0f172a;
        }

        /* Table Card */
        .borrowings-table-card {
            background: #ffffff;
            border: 1px solid #f1f5f9;
            border-radius: 12px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
            overflow: hidden;
        }
        .borrowings-data-table {
            width: 100%;
            border-collapse: collapse;
        }
        .borrowings-data-table th {
            padding: 14px 24px;
            font-size: 0.72rem;
            font-weight: 700;
            color: #64748b;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            border-bottom: 1px solid #f1f5f9;
            background: #ffffff;
            line-height: 1.3;
        }
        .borrowings-data-table td {
            padding: 16px 24px;
            border-bottom: 1px solid #f8fafc;
            color: #334155;
            vertical-align: middle;
            font-size: 0.85rem;
        }
        .borrowings-data-table tbody tr:hover {
            background-color: #fafbfc;
        }

        /* Book Details Column */
        .book-details-flex {
            display: flex;
            align-items: center;
            gap: 16px;
            min-width: 270px;
        }
        .book-symbol-box {
            width: 42px;
            height: 48px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }
        .book-symbol-box.active-loan {
            background: #eff6ff;
            color: #2563eb;
        }
        .book-symbol-box.returned-loan {
            background: #f8fafc;
            color: #64748b;
            border: 1px solid #f1f5f9;
        }
        .book-cover-thumb {
            width: 48px;
            height: 64px;
            flex: 0 0 48px;
            border-radius: 6px;
            object-fit: cover;
            box-shadow: 0 1px 3px rgba(15, 23, 42, .16);
        }
        .book-title-link {
            font-size: 0.95rem;
            font-weight: 700;
            color: #0f172a;
            text-decoration: none;
            display: block;
            line-height: 1.25;
        }
        .book-title-link:hover {
            color: #2563eb;
        }
        .book-author-text {
            color: #64748b;
            font-size: 0.8rem;
            margin-top: 2px;
        }
        .book-meta-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 6px;
        }
        .book-isbn-text {
            color: #94a3b8;
            font-size: 0.75rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        }
        .book-cat-badge {
            background: #eff6ff;
            color: #1d4ed8;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 2px 7px;
            border-radius: 4px;
        }

        /* Date Cells */
        .date-primary-text {
            font-size: 0.85rem;
            font-weight: 700;
            color: #0f172a;
            line-height: 1.25;
        }
        .date-sub-text {
            font-size: 0.75rem;
            color: #64748b;
            margin-top: 2px;
        }
        .dash-text {
            color: #94a3b8;
            font-size: 1rem;
        }

        /* Status Pills */
        .loan-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 11px;
            border-radius: 9999px;
            font-size: 0.74rem;
            font-weight: 600;
            white-space: nowrap;
        }
        .loan-status-pill.borrowed {
            background: #fef3c7;
            color: #b45309;
        }
        .loan-status-pill.returned {
            background: #dcfce7;
            color: #15803d;
        }
        .loan-status-pill.overdue {
            background: #fee2e2;
            color: #b91c1c;
        }
        .loan-due-text {
            color: #d97706;
            font-size: 0.74rem;
            font-weight: 500;
            margin-top: 3px;
        }
        .loan-overdue-text {
            color: #dc2626;
            font-size: 0.74rem;
            font-weight: 500;
            margin-top: 3px;
        }

        /* Inline Return Button */
        .borrow-return-btn-small {
            margin-top: 4px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 6px;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #047857;
            font-size: 0.72rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .borrow-return-btn-small:hover {
            background: #047857;
            border-color: #047857;
            color: #ffffff;
        }

        /* Footer & Pagination */
        .borrowings-footer-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 16px 24px;
            border-top: 1px solid #f1f5f9;
            color: #64748b;
            font-size: 0.82rem;
        }
        .borrowings-pages-nav {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .borrowings-pages-nav a,
        .borrowings-pages-nav span {
            min-width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 10px;
            border-radius: 6px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            color: #334155;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 500;
            transition: all 0.15s ease;
        }
        .borrowings-pages-nav a:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #0f172a;
        }
        .borrowings-pages-nav .selected-page {
            background: #1e3a8a;
            border-color: #1e3a8a;
            color: #ffffff !important;
            font-weight: 600;
        }
        .borrowings-pages-nav .nav-arrow {
            border: none;
            background: transparent;
            color: #64748b;
        }
        .borrowings-pages-nav .nav-arrow:hover {
            background: #f1f5f9;
            color: #0f172a;
        }
        .borrowings-pages-nav .nav-arrow.disabled {
            opacity: 0.4;
            pointer-events: none;
        }

        /* Empty State */
        .borrowings-empty-state {
            padding: 60px 20px;
            text-align: center;
            color: #64748b;
        }

        /* Responsive */
        @@media (max-width: 991px) {
            .borrowings-metric-grid {
                grid-template-columns: 1fr;
            }
            .filter-buttons-wrapper {
                margin-left: 0;
                width: 100%;
                justify-content: flex-start;
            }
        }
        @@media (max-width: 768px) {
            .borrowings-page-header {
                flex-direction: column;
                align-items: flex-start;
            }
            .borrowings-data-table {
                min-width: 700px;
            }
            .borrowings-footer-bar {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
}

<div class="my-borrowings-container">
    <!-- Page Header -->
    <header class="borrowings-page-header">
        <div>
            <h1>My Borrowings</h1>
            <p>Manage your active book loans, track due dates, and view your complete reading history.</p>
        </div>
        <div class="borrowings-desk-badge">
            <span class="status-indicator-dot"></span>
            <span>Library Desk Circulation Active</span>
        </div>
    </header>

    <!-- 2 Metric Cards -->
    <section class="borrowings-metric-grid">
        <!-- Card 1: Currently Borrowed -->
        <article class="borrowings-stat-card">
            <div>
                <div class="stat-card-top">
                    <span class="stat-card-label">CURRENTLY BORROWED</span>
                    <div class="stat-card-icon-box peach">
                        <i class="bi bi-bookmark" aria-hidden="true"></i>
                    </div>
                </div>
                <div class="stat-card-number-row">
                    <span class="stat-card-number">@Model.ActiveBorrowingsCount</span>
                    <span class="stat-card-pill amber">@Model.ActiveBorrowingsCount active loans</span>
                </div>
            </div>
            <div class="stat-card-footer peach-subtle">
                @if (Model.NextDueDate.HasValue)
                {
                    var daysUntilDue = (Model.NextDueDate.Value.Date - DateTime.Today).Days;
                    <span class="footer-highlight-amber">
                        <i class="bi bi-clock" aria-hidden="true"></i>
                        @(daysUntilDue < 0 ? $"Next overdue by {Math.Abs(daysUntilDue)} days" : $"Next due in {daysUntilDue} days")
                    </span>
                }
                else
                {
                    <span class="footer-highlight-amber">No active loans</span>
                }
                <span class="footer-meta-id">Ref: ID @LibraryIdentifiers.Member(Model.MemberId)</span>
            </div>
        </article>

        <!-- Card 2: Total Borrowed -->
        <article class="borrowings-stat-card">
            <div>
                <div class="stat-card-top">
                    <span class="stat-card-label">TOTAL BORROWED</span>
                    <div class="stat-card-icon-box blue">
                        <i class="bi bi-calendar-check" aria-hidden="true"></i>
                    </div>
                </div>
                <div class="stat-card-number-row">
                    <span class="stat-card-number">@Model.TotalBorrowedCount</span>
                    <span class="stat-card-pill blue">Lifetime total</span>
                </div>
            </div>
            <div class="stat-card-footer blue-subtle">
                <span class="footer-highlight-green">
                    <i class="bi bi-check-circle text-success" aria-hidden="true"></i>
                    @(Model.OverdueCount == 0 ? "Account in Good Standing" : $"{Model.OverdueCount} Overdue Item(s)")
                </span>
                <span class="footer-meta-id">@Model.OverdueCount Overdue Penalties</span>
            </div>
        </article>
    </section>

    <!-- Filters Section -->
    <section class="borrowings-filter-card">
        <form method="get" asp-action="Borrow" class="borrowings-filter-form">
            <div class="filter-field-group">
                <label for="filterStatus">Status</label>
                <select id="filterStatus" name="status" class="filter-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.StatusFilter))">All Statuses</option>
                    <option value="Borrowed" selected="@(Model.StatusFilter == "Borrowed")">Borrowed</option>
                    <option value="Returned" selected="@(Model.StatusFilter == "Returned")">Returned</option>
                </select>
            </div>

            <div class="filter-field-group">
                <label for="filterFromDate">From</label>
                <input id="filterFromDate" type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="filter-input" />
            </div>

            <div class="filter-field-group">
                <label for="filterToDate">To</label>
                <input id="filterToDate" type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="filter-input" />
            </div>

            <div class="filter-buttons-wrapper">
                <button type="submit" class="btn-filter-apply">
                    <i class="bi bi-funnel" aria-hidden="true"></i>
                    <span>Apply</span>
                </button>
                <a asp-action="Borrow" class="btn-filter-reset">Reset</a>
            </div>
        </form>
    </section>

    <!-- Borrowings Table -->
    <section class="borrowings-table-card">
        @if (Model.Borrowings.Count == 0)
        {
            <div class="borrowings-empty-state">
                <i class="bi bi-journal-bookmark" style="font-size: 2.5rem; opacity: 0.5;" aria-hidden="true"></i>
                <p class="fw-semibold mt-3 mb-1">No borrowing records match these filters.</p>
                <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-outline-primary mt-2">Browse Books</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="borrowings-data-table">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 44%;">BOOK DETAILS</th>
                            <th scope="col" style="width: 18%;">BORROW<br />DATE</th>
                            <th scope="col" style="width: 18%;">RETURN<br />DATE</th>
                            <th scope="col" style="width: 20%;">STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model.Borrowings)
                        {
                            <tr>
                                <!-- Book Details -->
                                <td>
                                    <div class="book-details-flex">
                                        @if (!string.IsNullOrWhiteSpace(loan.BookImageUrl))
                                        {
                                            <img class="book-cover-thumb" src="~/Images/@loan.BookImageUrl" alt="Cover of @loan.BookTitle" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="book-symbol-box @(loan.IsReturned ? "returned-loan" : "active-loan")">
                                                <i class="bi @(loan.IsReturned ? "bi-book" : "bi-journal-bookmark-fill")" aria-hidden="true"></i>
                                            </div>
                                        }
                                        <div>
                                            <a asp-controller="Book" asp-action="Details" asp-route-id="@loan.BookId" class="book-title-link">
                                                @loan.BookTitle
                                            </a>
                                            <div class="book-author-text">@loan.BookAuthor</div>
                                            <div class="book-meta-row">
                                                <span class="book-isbn-text">ISBN @loan.BookISBN</span>
                                                @if (!string.IsNullOrWhiteSpace(loan.CategoryName))
                                                {
                                                    <span class="book-cat-badge">@loan.CategoryName</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Borrow Date -->
                                <td>
                                    <div class="date-primary-text">@loan.BorrowDate.ToString("MMM dd, yyyy")</div>
                                    <div class="date-sub-text">@loan.BorrowDate.ToString("hh:mm tt")</div>
                                </td>

                                <!-- Return Date -->
                                <td>
                                    @if (loan.ReturnDate.HasValue)
                                    {
                                        <div class="date-primary-text">@loan.ReturnDate.Value.ToString("MMM dd, yyyy")</div>
                                        <div class="date-sub-text">Desk Rec #@loan.BorrowingId</div>
                                    }
                                    else
                                    {
                                        <span class="dash-text">—</span>
                                    }
                                </td>

                                <!-- Status -->
                                <td>
                                    @if (loan.IsReturned)
                                    {
                                        <span class="loan-status-pill returned">● Returned</span>
                                    }
                                    else if (loan.IsOverdue)
                                    {
                                        <span class="loan-status-pill overdue">● Overdue</span>
                                        <div class="loan-overdue-text">@loan.DaysOverdue days overdue</div>
                                        <form asp-controller="Member" asp-action="Return" asp-route-id="@loan.BorrowingId" method="post" onsubmit="return confirm('Confirm returning &quot;@loan.BookTitle&quot;?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="borrow-return-btn-small" title="Return this book">Return Book ↵</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="loan-status-pill borrowed">● Borrowed</span>
                                        <div class="loan-due-text">Due in @loan.DaysRemaining days</div>
                                        <form asp-controller="Member" asp-action="Return" asp-route-id="@loan.BorrowingId" method="post" onsubmit="return confirm('Confirm returning &quot;@loan.BookTitle&quot;?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="borrow-return-btn-small" title="Return this book">Return Book ↵</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer & Pagination -->
            <footer class="borrowings-footer-bar">
                <div>Showing @firstRecord to @lastRecord of @Model.MatchingRecordCount borrowings</div>
                @if (Model.TotalPages > 1)
                {
                    <nav class="borrowings-pages-nav" aria-label="Borrowings pagination">
                        <a asp-action="Borrow" asp-route-status="@Model.StatusFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageNumber="@(Model.PageNumber - 1)" class="nav-arrow @(Model.PageNumber == 1 ? "disabled" : "")">
                            &lt; Previous
                        </a>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <a asp-action="Borrow" asp-route-status="@Model.StatusFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageNumber="@p" class="@(p == Model.PageNumber ? "selected-page" : "")">
                                @p
                            </a>
                        }
                        <a asp-action="Borrow" asp-route-status="@Model.StatusFilter" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-pageNumber="@Model.PageNumber + 1" class="nav-arrow @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                            Next &gt;
                        </a>
                    </nav>
                }
            </footer>
        }
    </section>
</div>
