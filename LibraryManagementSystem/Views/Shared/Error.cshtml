@model LibraryManagementSystem.Models.ErrorViewModel
@{
    var is404 = Model?.IsNotFound == true || Model?.StatusCode == 404;
    ViewData["Title"] = is404 ? "Page Not Found (404)" : "Error " + (Model?.StatusCode ?? 500);
    var errorRef = !string.IsNullOrEmpty(Model?.RequestId) ? Model.RequestId : (is404 ? "ERR_LMS_404_PAGE_NOT_FOUND" : "ERR_LMS_500_DB_CONN");
    var timestamp = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") + " UTC";
}

<div class="d-flex justify-content-center align-items-center py-5 min-vh-75">
    <div class="card error-card border-0 shadow-sm rounded-4 p-4 p-sm-5 text-center" style="width: 100%; max-width: 540px; background: #ffffff;">
        
        @if (is404)
        {
            <!-- ================= 404 NOT FOUND STATE ================= -->
            <!-- 404 Pill Badge -->
            <div>
                <span class="error-badge badge-404">
                    <span class="error-dot dot-404"></span>
                    <span>ERROR 404 • PAGE NOT FOUND</span>
                </span>
            </div>

            <!-- 404 Search / Compass Icon -->
            <div class="error-icon-wrapper icon-wrapper-404 mx-auto">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="8.01"></line>
                    <line x1="11" y1="11" x2="11" y2="14"></line>
                </svg>
            </div>

            <!-- 404 Title & Subtitle -->
            <h2 class="error-title">Page not found</h2>
            <p class="error-description">
                Sorry, the page you are looking for doesn't exist, was removed, or is temporarily unavailable.
            </p>

            <!-- Diagnostic Details Box -->
            <div class="diagnostic-box text-start">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="diagnostic-header-title d-flex align-items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>Diagnostic Details</span>
                    </span>
                    <button type="button" class="btn-copy-ref" onclick="copyRefToClipboard('@errorRef')">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                        </svg>
                        <span id="copyBtnText">Copy Ref</span>
                    </button>
                </div>
                <div class="d-flex flex-wrap justify-content-between diagnostic-content">
                    <div>Ref: <span class="font-monospace text-dark fw-semibold">@errorRef</span></div>
                    <div>Status: <span class="font-monospace text-dark">404 Not Found</span></div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-center gap-2 mb-4">
                <a href="/" class="btn btn-primary-home d-inline-flex align-items-center gap-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Back to Home</span>
                </a>
                <a href="/Books" class="btn btn-try-again d-inline-flex align-items-center gap-2 text-decoration-none">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                        <path d="M6 6h10"></path>
                        <path d="M6 10h10"></path>
                    </svg>
                    <span>Browse Books</span>
                </a>
            </div>
        }
        else
        {
            <!-- ================= 500 SERVER ERROR STATE ================= -->
            <!-- 500 Pill Badge -->
            <div>
                <span class="error-badge">
                    <span class="error-dot"></span>
                    <span>ERROR @(Model?.StatusCode ?? 500) • INTERNAL SERVER ERROR</span>
                </span>
            </div>

            <!-- Error Warning Box -->
            <div class="error-icon-wrapper mx-auto">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>

            <!-- Title & Subtitle -->
            <h2 class="error-title">Something went wrong</h2>
            <p class="error-description">
                An unexpected error occurred while processing your request. Our technical team has been notified and is actively resolving the issue.
            </p>

            <!-- Diagnostic Details Box -->
            <div class="diagnostic-box text-start">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="diagnostic-header-title d-flex align-items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span>Diagnostic Details</span>
                    </span>
                    <button type="button" class="btn-copy-ref" onclick="copyRefToClipboard('@errorRef')">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                        </svg>
                        <span id="copyBtnText">Copy Ref</span>
                    </button>
                </div>
                <div class="d-flex flex-wrap justify-content-between diagnostic-content">
                    <div>Ref: <span class="font-monospace text-dark fw-semibold">@errorRef</span></div>
                    <div>Timestamp: <span class="font-monospace text-dark">@timestamp</span></div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-center gap-2 mb-4">
                <a href="/" class="btn btn-primary-home d-inline-flex align-items-center gap-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Back to Home</span>
                </a>
                <button type="button" class="btn btn-try-again d-inline-flex align-items-center gap-2" onclick="window.location.reload();">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                        <polyline points="3 3 3 8 8 8"></polyline>
                        <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
                        <polyline points="16 16 21 16 21 21"></polyline>
                    </svg>
                    <span>Try Again</span>
                </button>
            </div>
        }

        <!-- Help / Contact Note -->
        <div class="error-contact-note">
            <span>Need immediate assistance?</span>
            <a href="mailto:support@librarysystem.org" class="contact-link">Contact System Desk ↗</a>
        </div>
    </div>
</div>

<style>
    .error-card {
        border-radius: 20px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    }

    .error-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #fef2f2;
        color: #dc2626;
        border: 1px solid #fee2e2;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.6px;
        text-transform: uppercase;
    }

    .badge-404 {
        background-color: #fffbeb;
        color: #b45309;
        border-color: #fef3c7;
    }

    .error-dot {
        width: 6px;
        height: 6px;
        background-color: #dc2626;
        border-radius: 50%;
        display: inline-block;
    }

    .dot-404 {
        background-color: #d97706;
    }

    .error-icon-wrapper {
        width: 58px;
        height: 58px;
        background-color: #fef2f2;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 20px;
        margin-bottom: 16px;
    }

    .icon-wrapper-404 {
        background-color: #fffbeb;
    }

    .error-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .error-description {
        font-size: 0.88rem;
        color: #64748b;
        max-width: 440px;
        margin: 0 auto 24px;
        line-height: 1.5;
    }

    .diagnostic-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 0.78rem;
        color: #64748b;
        margin-bottom: 24px;
    }

    .diagnostic-header-title {
        font-weight: 600;
        color: #475569;
        font-size: 0.78rem;
    }

    .btn-copy-ref {
        background: none;
        border: none;
        color: #2563eb;
        font-size: 0.75rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 4px;
        transition: background-color 0.15s;
    }

    .btn-copy-ref:hover {
        background-color: #eff6ff;
        color: #1d4ed8;
    }

    .diagnostic-content {
        font-size: 0.75rem;
        gap: 8px;
    }

    .btn-primary-home {
        background-color: #1e3a8a;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.15s;
    }

    .btn-primary-home:hover {
        background-color: #172554;
        color: #ffffff;
    }

    .btn-try-again {
        background-color: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 0.88rem;
        font-weight: 600;
        transition: background-color 0.15s, border-color 0.15s;
    }

    .btn-try-again:hover {
        background-color: #e2e8f0;
        color: #0f172a;
    }

    .error-contact-note {
        font-size: 0.82rem;
        color: #64748b;
    }

    .contact-link {
        color: #1e3a8a;
        font-weight: 600;
        text-decoration: none;
        margin-left: 4px;
    }

    .contact-link:hover {
        text-decoration: underline;
    }
</style>

<script>
    function copyRefToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            var btnText = document.getElementById("copyBtnText");
            btnText.innerText = "Copied!";
            setTimeout(function() {
                btnText.innerText = "Copy Ref";
            }, 2000);
        });
    }
</script>

