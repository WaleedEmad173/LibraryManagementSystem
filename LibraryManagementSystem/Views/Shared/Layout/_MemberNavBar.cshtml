@using Microsoft.AspNetCore.Identity
@using LibraryManagementSystem.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    var user = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Admin");
    var isLibrarian = User.IsInRole("Librarian");
    var isStaff = isAdmin || isLibrarian;

    var fullName = !string.IsNullOrWhiteSpace(user?.FullName) ? user.FullName : (User.Identity?.Name ?? (isAdmin ? "Admin User" : isLibrarian ? "Librarian" : "Member"));
    var idPrefix = isAdmin ? "#ADM-" : (isLibrarian ? "#LIB-" : "#MB-");
    var memberId = user != null ? $"{idPrefix}{user.Id:D4}" : (isAdmin ? "#ADM-0001" : isLibrarian ? "#LIB-0104" : "#MB-4820");

    var primaryRole = isAdmin ? "Admin" : (isLibrarian ? "Librarian" : "Member");
    var portalName = isAdmin ? "Admin Portal" : (isLibrarian ? "Librarian Portal" : "Member Portal");

    var sectionTitle = ViewData["Section"]?.ToString();
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    if (string.IsNullOrWhiteSpace(sectionTitle))
    {
        if (currentPath.Contains("/book")) sectionTitle = "Books";
        else if (currentPath.Contains("/categories")) sectionTitle = "Categories";
        else if (currentPath.Contains("/members")) sectionTitle = "Members";
        else if (currentPath.Contains("/borrow")) sectionTitle = isStaff ? "Borrow" : "My Borrowings";
        else if (currentPath.Contains("/return")) sectionTitle = "Return";
        else if (currentPath.Contains("/history")) sectionTitle = "Circulation History";
        else if (currentPath.Contains("/staff")) sectionTitle = "Staff Accounts";
        else sectionTitle = isStaff ? "Dashboard" : "Home";
    }
}

<header class="app-top-navbar bg-white">
    <div class="navbar-content d-flex align-items-center justify-content-between">
        <!-- Left Side: Portal & Breadcrumbs -->
        <div class="portal-title-wrapper d-flex align-items-center">
            <button type="button" class="btn-topbar-sidebar-toggle me-3" id="globalSidebarToggle" title="Toggle Sidebar">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
            <div class="member-portal-crumbs">
                <span>@portalName</span>
                <span>/</span>
                <strong>@sectionTitle</strong>
            </div>
        </div>

        <!-- Right Side: User Profile & Actions -->
        <div class="user-actions d-flex align-items-center">
            <!-- User Info Card -->
            <div class="user-profile-badge d-flex align-items-center me-3">
                <!-- Avatar Icon -->
                <div class="user-avatar-box me-2 @(isAdmin ? "avatar-admin" : isLibrarian ? "avatar-librarian" : "")">
                    <img src="~/Images/icons/person.png" alt="User Avatar" width="16" height="16" class="avatar-icon" />
                </div>

                <!-- Name and ID -->
                <div class="user-text-info me-3">
                    <div class="user-fullname">@fullName</div>
                    <div class="user-id">ID: @memberId</div>
                </div>

                <!-- Role Pill -->
                <span class="role-badge @(isAdmin ? "role-admin" : isLibrarian ? "role-librarian" : "role-member")">@primaryRole</span>
            </div>

            <!-- Divider -->
            <div class="nav-divider"></div>

            <!-- Logout Button Form -->
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout" title="Sign out">
                    <svg class="logout-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </div>
</header>
