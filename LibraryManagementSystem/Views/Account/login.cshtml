@model LoginViewModel
@{
    Layout = null; // standalone page: no sidebar / top bar for signed-out visitors
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Library System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/library.css" asp-append-version="true" />
    <style>
        .auth-page { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
        .auth-aside { background: var(--navy); color: #cfd8ff; padding: 48px; display: flex; flex-direction: column; justify-content: space-between; }
        .auth-aside .brand { margin-bottom: 0; }
        .auth-aside h2 { color: #fff; font-size: 30px; font-weight: 800; line-height: 1.2; max-width: 14ch; }
        .auth-aside p { margin-top: 12px; max-width: 34ch; color: #b8c4ff; }
        .auth-main { display: grid; place-items: center; padding: 32px; }
        .auth-card { width: 100%; max-width: 420px; }
        .auth-card h1 { margin-bottom: 4px; }
        .auth-card .field { margin-top: 18px; }
        .auth-card .btn { width: 100%; justify-content: center; margin-top: 22px; padding: 12px 16px; }
        .check-row { display: flex; align-items: center; gap: 8px; margin-top: 16px; font-weight: 500; }
        .check-row input { width: auto; }
        .auth-foot { margin-top: 20px; text-align: center; color: var(--muted); }
        .auth-foot a { color: var(--navy); font-weight: 600; }
        @@media (max-width: 800px) { .auth-page { grid-template-columns: 1fr; } .auth-aside { display: none; } }
    </style>
</head>
<body>
    <div class="auth-page">
        <aside class="auth-aside">
            <div class="brand">
                <span class="brand-logo"><i class="bi bi-journal-bookmark"></i></span>
                <div>
                    <div class="brand-name">Library System</div>
                    <div class="brand-sub">LIBRARIAN PORTAL</div>
                </div>
            </div>
            <div>
                <h2>Manage the catalog and every loan in one place.</h2>
                <p>Sign in to add books, track copies on the shelf, and see who has what.</p>
            </div>
        </aside>

        <main class="auth-main">
            <section class="card auth-card accent-navy">
                <h1>Sign in</h1>
                <p class="muted">Use the email and password for your library account.</p>

                <form asp-action="Login" method="post" novalidate>
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-error" style="margin:16px 0 0"></div>

                    <div class="field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" autocomplete="username" autofocus />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" type="password" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <label class="check-row">
                        <input asp-for="RememberMe" type="checkbox" /> Keep me signed in on this device
                    </label>

                    <button type="submit" class="btn btn-primary">Sign in</button>
                </form>

                <p class="auth-foot">New member? <a asp-action="Register">Create an account</a></p>
            </section>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
