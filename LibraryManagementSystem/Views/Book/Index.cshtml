@model BookIndexViewModel
@{
    ViewData["Title"] = "Books";

    // Clicking a header toggles asc/desc; other filters are kept
    var titleSort = Model.SortOrder == "title_desc" ? null : "title_desc";
    var authorSort = Model.SortOrder == "author" ? "author_desc" : "author";
}

<div class="books-management-page">
    <!-- Header Section: Title, Badge, Subtitle & Action Buttons -->
    <div class="books-header-wrapper d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="books-title m-0">Books</h1>
                <span class="badge-master-catalog">Master Catalog</span>
            </div>
            <p class="books-subtitle m-0">Manage library inventory, catalog new acquisitions, and monitor copy availability.</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
        {
            <div class="books-head-actions d-flex align-items-center gap-2">
                <button type="button" class="btn-export-csv" disabled title="Coming soon">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Export CSV
                </button>
                <a class="btn-add-book" asp-action="Create">
                    <i class="bi bi-plus-lg me-1"></i> Add New Book
                </a>
            </div>
        }
    </div>

    <!-- 4 Key Metrics Cards -->
    <partial name="_StatsCards" model="Model" />

    <!-- Filters & Live Status Counters -->
    <partial name="_Filters" model="Model" />

    <!-- Books Master Table Card -->
    <div class="books-table-card">
        <div class="table-responsive">
            <table class="books-modern-table">
                <thead>
                    <tr>
                        <th class="th-title">
                            <a class="sort-link" asp-action="Index" asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId" asp-route-sortOrder="@titleSort">
                                TITLE
                                @if (Model.SortOrder == null || Model.SortOrder == "title_desc")
                                {
                                    <i class="bi @(Model.SortOrder == "title_desc" ? "bi-arrow-down" : "bi-arrow-up")"></i>
                                }
                            </a>
                        </th>
                        <th class="th-author">
                            <a class="sort-link" asp-action="Index" asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId" asp-route-sortOrder="@authorSort">
                                AUTHOR
                                @if (Model.SortOrder == "author" || Model.SortOrder == "author_desc")
                                {
                                    <i class="bi @(Model.SortOrder == "author_desc" ? "bi-arrow-down" : "bi-arrow-up")"></i>
                                }
                            </a>
                        </th>
                        <th class="th-isbn">ISBN</th>
                        <th class="th-category">CATEGORY</th>
                        <th class="th-copies">COPIES <span class="th-sub">(Available / Total)</span></th>
                        <th class="th-actions text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Books.Any())
                    {
                        foreach (var book in Model.Books)
                        {
                            <partial name="_BookRow" model="book" />
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-state py-5 text-center text-muted">
                                <i class="bi bi-search display-6 d-block mb-2 text-secondary opacity-50"></i>
                                <div class="fw-semibold">No books match your search or filter.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model" />
    </div>
</div>
