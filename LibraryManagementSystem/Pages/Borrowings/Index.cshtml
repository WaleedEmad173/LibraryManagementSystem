@page
@model LibraryManagementSystem.Pages.Borrowings.IndexModel
@{
    ViewData["Title"] = "Circulation Audit History";
}

<div class="circulation-container mt-2">
    <!-- Module Tabs Switcher -->
    <div class="circ-module-tabs">
        <a asp-page="./Borrow" class="circ-tab-btn">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Borrow a Book
        </a>
        <a asp-page="./Return" class="circ-tab-btn">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
            </svg>
            Return a Book
        </a>
        <a asp-page="./Index" class="circ-tab-btn active">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            Circulation History
        </a>
    </div>

    <!-- Header Section Matching Figma Screen 3 -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <div class="circ-terminal-badge">CIRCULATION AUDIT LEDGER • LIVE DATABASE</div>
            <h1 class="circ-title">Borrowing History</h1>
            <p class="circ-subtitle mb-0">
                Complete audit log of catalog circulation events, active checkouts, and historic returns.
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0 align-items-center">
            <button type="button" class="btn btn-outline-secondary px-3 py-2 rounded-3 fw-semibold d-inline-flex align-items-center gap-2" onclick="exportTableToCsv()">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Export CSV / Report
            </button>
            <a asp-page="./Borrow" class="circ-btn-primary">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
                New Borrow Loan
            </a>
            <a asp-page="./Return" class="circ-btn-secondary">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                </svg>
                Check-in Console
            </a>
        </div>
    </div>

    <!-- 3 Metrics Cards (Accurate DB Counts matching Figma) -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="circ-card p-3 d-flex align-items-center gap-3">
                <div class="circ-stat-chip-icon" style="color: #2563eb; width: 44px; height: 44px; background: #eff6ff;">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div>
                    <div class="circ-stat-chip-label">TOTAL RECORDS</div>
                    <div class="circ-title fs-4 mb-0">@Model.ViewModel.TotalBorrowedCount All Time</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="circ-card p-3 d-flex align-items-center gap-3">
                <div class="circ-stat-chip-icon" style="color: #d97706; width: 44px; height: 44px; background: #fef3c7;">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <div class="circ-stat-chip-label">ACTIVE LOANS</div>
                    <div class="circ-title fs-4 mb-0">@Model.ViewModel.CurrentlyBorrowedCount Requires Return</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="circ-card p-3 d-flex align-items-center gap-3">
                <div class="circ-stat-chip-icon" style="color: #059669; width: 44px; height: 44px; background: #ecfdf5;">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <div class="circ-stat-chip-label">COMPLETED RETURNS</div>
                    <div class="circ-title fs-4 mb-0">@Model.ViewModel.CompletedReturnsCount Restored</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Audit Trails Card (Figma Style) -->
    <div class="circ-card mb-4">
        <div class="circ-card-header py-2 px-3 bg-light">
            <span class="fw-bold small text-slate-800 d-flex align-items-center gap-2">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                </svg>
                Filter Audit Trails
            </span>
            <span class="text-muted small">Refining @Model.ViewModel.Borrowings.Count historical entries</span>
        </div>
        <div class="circ-card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-lg-2 col-md-4">
                    <label class="circ-label mb-1">Status</label>
                    <select name="status" class="circ-select py-1">
                        <option value="">All Operations</option>
                        <option value="Borrowed" selected="@(Model.ViewModel.StatusFilter == "Borrowed")">Active Loans</option>
                        <option value="Returned" selected="@(Model.ViewModel.StatusFilter == "Returned")">Returned</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-4">
                    <label class="circ-label mb-1">Member</label>
                    <input type="text" name="searchMember" value="@Model.ViewModel.SearchMember" class="circ-input py-1" placeholder="Search by member name or ID" />
                </div>
                <div class="col-lg-3 col-md-4">
                    <label class="circ-label mb-1">Book</label>
                    <input type="text" name="searchBook" value="@Model.ViewModel.SearchBook" class="circ-input py-1" placeholder="Search by book title or ISBN" />
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="circ-label mb-1">From Date</label>
                    <input type="date" name="fromDate" value="@(Model.ViewModel.FromDate?.ToString("yyyy-MM-dd"))" class="circ-input py-1" />
                </div>
                <div class="col-lg-2 col-md-6 d-flex gap-2">
                    <button type="submit" class="circ-btn-search py-1 flex-grow-1 justify-content-center">
                        Apply Filters
                    </button>
                    @if (!string.IsNullOrEmpty(Model.ViewModel.StatusFilter) || !string.IsNullOrEmpty(Model.ViewModel.SearchMember) || !string.IsNullOrEmpty(Model.ViewModel.SearchBook) || Model.ViewModel.FromDate.HasValue)
                    {
                        <a asp-page="./Index" class="circ-btn-secondary py-1 px-3" title="Clear Filters">Reset</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Main Table Card with Real Components & Figma Look -->
    <div class="circ-card">
        <div class="circ-card-header">
            <h3 class="circ-card-title">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#2563eb">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                </svg>
                Circulation Ledger Entries
            </h3>
            <span class="text-muted small">Showing @Model.ViewModel.Borrowings.Count entries</span>
        </div>

        <div class="circ-table-container">
            <table class="circ-table" id="ledgerTable">
                <thead>
                    <tr>
                        <th>MEMBER</th>
                        <th>BOOK TITLE</th>
                        <th>BORROW DATE</th>
                        <th>RETURN DATE</th>
                        <th>STATUS</th>
                        <th class="text-end pe-4">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ViewModel.Borrowings.Any())
                    {
                        @foreach (var item in Model.ViewModel.Borrowings)
                        {
                            <tr>
                                <!-- Member Cell with Initials Avatar Circle -->
                                <td>
                                    <div class="circ-table-user-cell">
                                        <div class="circ-mini-avatar">
                                            @item.BorrowerInitials
                                        </div>
                                        <div>
                                            <div class="fw-bold text-slate-900">@item.BorrowerName</div>
                                            <div class="text-muted small">@item.MemberId</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Book Title Cell with Outline Book Icon -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#64748b" class="flex-shrink-0">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                        </svg>
                                        <div>
                                            <div class="fw-bold text-slate-900">@item.BookTitle</div>
                                            <div class="text-muted small">@item.BookAuthor</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Borrow Date -->
                                <td>
                                    <span class="text-slate-800 fw-medium">@item.BorrowDate.ToString("MMM dd, yyyy")</span>
                                </td>

                                <!-- Return Date -->
                                <td>
                                    @if (item.IsReturned)
                                    {
                                        <span class="text-slate-800 fw-medium">@item.ReturnDate!.Value.ToString("MMM dd, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fw-bold">&mdash;</span>
                                    }
                                </td>

                                <!-- Status Badge Matching Figma -->
                                <td>
                                    @if (item.IsReturned)
                                    {
                                        <span class="circ-badge circ-badge-emerald">• Returned</span>
                                    }
                                    else if (item.IsOverdue)
                                    {
                                        <span class="circ-badge circ-badge-rose">• Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="circ-badge circ-badge-amber">• Borrowed</span>
                                    }
                                </td>

                                <!-- Enhanced Actions Column: Sleek Eye Icon Button + Quick Modal + Details link -->
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <!-- Quick Return action if active -->
                                        @if (!item.IsReturned)
                                        {
                                            <form method="post" asp-page="./Return" asp-page-handler="Return" class="d-inline">
                                                <input type="hidden" name="id" value="@item.BorrowingId" />
                                                <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2 rounded-2 fw-semibold" title="Return Book" onclick="return confirm('Process return for this loan?');">
                                                    Return ↩
                                                </button>
                                            </form>
                                        }

                                        <!-- Enhanced View Details Eye Icon Button (Circled by user) -->
                                        <button type="button"
                                                class="btn btn-sm btn-light border py-1 px-2 rounded-3 text-secondary d-inline-flex align-items-center gap-1 shadow-sm view-detail-btn"
                                                title="View Audit Details"
                                                onclick="openDetailsModal({
                                                    id: @item.BorrowingId,
                                                    bookTitle: '@Html.Raw(item.BookTitle.Replace("'", "\\'"))',
                                                    bookAuthor: '@Html.Raw(item.BookAuthor.Replace("'", "\\'"))',
                                                    bookIsbn: '@Html.Raw(item.BookISBN.Replace("'", "\\'"))',
                                                    category: '@Html.Raw(item.CategoryName.Replace("'", "\\'"))',
                                                    borrowerName: '@Html.Raw(item.BorrowerName.Replace("'", "\\'"))',
                                                    borrowerEmail: '@Html.Raw(item.BorrowerEmail.Replace("'", "\\'"))',
                                                    memberId: '@item.MemberId',
                                                    borrowDate: '@item.BorrowDate.ToString("MMM dd, yyyy hh:mm tt")',
                                                    dueDate: '@item.DueDate.ToString("MMM dd, yyyy")',
                                                    returnDate: '@(item.ReturnDate.HasValue ? item.ReturnDate.Value.ToString("MMM dd, yyyy hh:mm tt") : "Not Returned (Active Loan)")',
                                                    status: '@(item.IsReturned ? "Returned" : item.IsOverdue ? "Overdue" : "Borrowed")'
                                                })">
                                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                            <span class="small fw-semibold">View</span>
                                        </button>

                                        <!-- Full Standalone Page Link -->
                                        <a asp-page="./Details" asp-route-id="@item.BorrowingId" class="btn btn-sm btn-link text-decoration-none text-muted p-1" title="Open Full Details Page">
                                            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                            </svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="py-4">
                                    <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="#94a3b8" class="mb-2">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                    <div class="fw-semibold">No circulation records found in ledger.</div>
                                    <div class="small mt-1"><a asp-page="./Borrow" class="text-primary">Issue a new borrow loan at the circulation desk</a></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Table Footer / Pagination Matching Figma -->
        <div class="circ-card-header py-3 bg-light border-top flex-wrap gap-2">
            <div class="text-muted small">
                Showing records 1 - @Model.ViewModel.Borrowings.Count of @Model.ViewModel.TotalBorrowedCount records
            </div>
            <div class="d-flex gap-1 align-items-center">
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" disabled>&lt;</button>
                <button type="button" class="btn btn-sm btn-primary py-1 px-2">1</button>
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2">&gt;</button>
            </div>
        </div>
    </div>

    <!-- Bottom Status Line Matching Figma Screen 3 -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 text-muted small">
        <div>
            • Summary Ledger: Total Records <strong>@Model.ViewModel.TotalBorrowedCount</strong> | Active Loans <strong>@Model.ViewModel.CurrentlyBorrowedCount</strong> | Completed Returns <strong>@Model.ViewModel.CompletedReturnsCount</strong>
        </div>
        <div>
            ISO-9001 Regulatory Verification Enabled - Audited by System Daemon
        </div>
    </div>
</div>

<!-- =========================================================================
     CIRCULATION AUDIT DETAILS MODAL (Interactive Enhancement for "View" Button)
     ========================================================================= -->
<div class="modal fade" id="circulationDetailsModal" tabindex="-1" aria-labelledby="circulationDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <!-- Modal Header -->
            <div class="modal-header bg-slate-900 text-white p-4" style="background: #0f172a;">
                <div>
                    <div class="text-uppercase text-light opacity-75 small fw-bold tracking-wider">Circulation Desk Audit Receipt</div>
                    <h4 class="modal-title fw-bold text-white mb-0" id="modalLoanRef">Loan Record #LN-0001</h4>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4 bg-light">
                <div class="row g-3">
                    <!-- Borrower Card -->
                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-3 p-3 bg-white">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted small text-uppercase fw-bold">Patron Account</span>
                                <span class="circ-badge circ-badge-blue" id="modalMemberId">#MB-4820</span>
                            </div>
                            <h5 class="fw-bold text-slate-900 mb-1" id="modalBorrowerName">Sara Ahmed</h5>
                            <div class="text-muted small mb-2" id="modalBorrowerEmail">sara.ahmed@example.com</div>
                            <div class="border-top pt-2 small text-secondary">
                                Standing: <strong class="text-success">Good Standing</strong> • Tier: Standard Academic
                            </div>
                        </div>
                    </div>

                    <!-- Book Card -->
                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-3 p-3 bg-white">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted small text-uppercase fw-bold">Catalog Item</span>
                                <span class="circ-badge circ-badge-emerald" id="modalCategory">Software Dev</span>
                            </div>
                            <h5 class="fw-bold text-slate-900 mb-1" id="modalBookTitle">Clean Code</h5>
                            <div class="text-muted small mb-2" id="modalBookAuthor">By Robert C. Martin</div>
                            <div class="border-top pt-2 small text-secondary" id="modalBookIsbn">
                                ISBN: 978-0132350884
                            </div>
                        </div>
                    </div>

                    <!-- Circulation Timeline & Status Card -->
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="text-muted small text-uppercase fw-bold">Loan Lifecycle & Dates</span>
                                <span id="modalStatusBadge" class="circ-badge circ-badge-emerald">• Returned</span>
                            </div>

                            <div class="row g-3 text-center">
                                <div class="col-sm-4">
                                    <div class="p-2 rounded-2 bg-light border">
                                        <div class="small text-muted">CHECKOUT DATE</div>
                                        <div class="fw-bold text-slate-900" id="modalBorrowDate">Oct 24, 2024</div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="p-2 rounded-2 bg-light border">
                                        <div class="small text-muted">POLICY DUE DATE</div>
                                        <div class="fw-bold text-slate-900" id="modalDueDate">Nov 07, 2024</div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="p-2 rounded-2 bg-light border">
                                        <div class="small text-muted">RETURNED ON</div>
                                        <div class="fw-bold text-slate-900" id="modalReturnDate">Oct 24, 2024</div>
                                    </div>
                                </div>
                            </div>

                            <div class="circ-notice-box mt-3">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#2563eb" class="flex-shrink-0 mt-1">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <div>
                                    <div class="circ-notice-title">Audit Ledger Certification</div>
                                    <p class="circ-notice-desc mb-0">
                                        This circulation transaction was authorized by the circulation desk terminal with standard 14-day checkout duration terms.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-white p-3 border-top">
                <button type="button" class="btn btn-outline-secondary px-3" onclick="window.print()">
                    Print Receipt ↗
                </button>
                <a id="modalFullPageLink" href="#" class="btn btn-primary px-3">
                    Open Full Page View →
                </a>
                <button type="button" class="btn btn-light border px-3" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDetailsModal(data) {
            document.getElementById('modalLoanRef').innerText = `Loan Record #LN-${String(data.id).padStart(4, '0')}`;
            document.getElementById('modalBorrowerName').innerText = data.borrowerName;
            document.getElementById('modalBorrowerEmail').innerText = data.borrowerEmail;
            document.getElementById('modalMemberId').innerText = data.memberId;
            document.getElementById('modalBookTitle').innerText = data.bookTitle;
            document.getElementById('modalBookAuthor').innerText = 'By ' + data.bookAuthor;
            document.getElementById('modalBookIsbn').innerText = 'ISBN: ' + data.bookIsbn;
            document.getElementById('modalCategory').innerText = data.category;
            document.getElementById('modalBorrowDate').innerText = data.borrowDate;
            document.getElementById('modalDueDate').innerText = data.dueDate;
            document.getElementById('modalReturnDate').innerText = data.returnDate;

            const badge = document.getElementById('modalStatusBadge');
            if (data.status === 'Returned') {
                badge.className = 'circ-badge circ-badge-emerald';
                badge.innerText = '• Returned';
            } else if (data.status === 'Overdue') {
                badge.className = 'circ-badge circ-badge-rose';
                badge.innerText = '• Overdue';
            } else {
                badge.className = 'circ-badge circ-badge-amber';
                badge.innerText = '• Active Loan (Borrowed)';
            }

            document.getElementById('modalFullPageLink').href = `/Borrowings/Details/${data.id}`;

            const modalEl = document.getElementById('circulationDetailsModal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        function exportTableToCsv() {
            const table = document.getElementById('ledgerTable');
            let csv = [];
            for (let i = 0; i < table.rows.length; i++) {
                let row = [], cols = table.rows[i].querySelectorAll('td, th');
                for (let j = 0; j < cols.length - 1; j++) {
                    let text = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/"/g, '""').trim();
                    row.push('"' + text + '"');
                }
                csv.push(row.join(','));
            }
            const csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
            const downloadLink = document.createElement('a');
            downloadLink.download = `circulation_history_${new Date().toISOString().slice(0, 10)}.csv`;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = 'none';
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
