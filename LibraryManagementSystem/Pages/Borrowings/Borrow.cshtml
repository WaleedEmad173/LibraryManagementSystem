@page "{id:int?}"
@model LibraryManagementSystem.Pages.Borrowings.BorrowModel
@{
    ViewData["Title"] = "Borrow a Book for a Member";
    var member = Model.ViewModel.SelectedMember;
    var book = Model.ViewModel.SelectedBook;
}

<div class="circulation-container mt-2">
    <!-- Module Tabs Switcher (No global navbar inside view, pure circulation module tabs) -->
    <div class="circ-module-tabs">
        <a asp-page="./Borrow" class="circ-tab-btn active">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Borrow a Book
        </a>
        <a asp-page="./Return" class="circ-tab-btn">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
            </svg>
            Return a Book
        </a>
        <a asp-page="./Index" class="circ-tab-btn">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            Circulation History
        </a>
    </div>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <div class="circ-terminal-badge">CIRCULATION TERMINAL #03 • Section 13 Desk: @DateTime.Now.ToString("hh:mm tt")</div>
            <h1 class="circ-title">Borrow a Book for a Member</h1>
            <p class="circ-subtitle mb-0">
                Process physical desk checkout and assign book inventory to a registered patron. Loans automatically enforce quota keys and standard duration rules.
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-lg-0">
            <div class="circ-stat-chip">
                <div class="circ-stat-chip-icon">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div>
                    <div class="circ-stat-chip-label">SYSTEM DATE</div>
                    <div class="circ-stat-chip-val">@DateTime.Today.ToString("MMM dd, yyyy")</div>
                </div>
            </div>
            <div class="circ-stat-chip">
                <div class="circ-stat-chip-icon" style="color: #10b981;">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <div class="circ-stat-chip-label">CIRCULATION COUNT</div>
                    <div class="circ-stat-chip-val">@Model.ViewModel.TransactedCount Transacted</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Execution Alert Banner -->
    @if (!string.IsNullOrEmpty(Model.ViewModel.AlertState))
    {
        if (Model.ViewModel.AlertState == "success")
        {
            <div class="circ-alert-card circ-alert-success">
                <div class="circ-alert-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <div class="circ-alert-body">
                    <div class="circ-alert-header">
                        <h4 class="circ-alert-title">@(Model.ViewModel.AlertTitle ?? "Book borrowed successfully")</h4>
                        <span class="circ-badge circ-badge-emerald">SUCCESS</span>
                    </div>
                    <p class="circ-alert-desc">@Model.ViewModel.AlertMessage</p>
                    <div class="circ-alert-footer">
                        <span>Return Due: <strong>@(Model.ViewModel.AlertDueDate?.ToString("MMM dd, yyyy") ?? DateTime.Today.AddDays(14).ToString("MMM dd, yyyy"))</strong> (14 Day Policy)</span>
                        <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 rounded-2" onclick="window.print()">Print Receipt ↗</button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="circ-alert-card circ-alert-danger">
                <div class="circ-alert-icon">
                    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div class="circ-alert-body">
                    <div class="circ-alert-header">
                        <h4 class="circ-alert-title">@(Model.ViewModel.AlertTitle ?? "Circulation Transaction Rejected")</h4>
                        <span class="circ-badge circ-badge-rose">REJECTED</span>
                    </div>
                    <p class="circ-alert-desc">@Model.ViewModel.AlertMessage</p>
                    <div class="circ-alert-footer">
                        <span>Earliest Estimated Return: <strong>@DateTime.Today.AddDays(4).ToString("MMM dd, yyyy")</strong></span>
                        <a href="javascript:void(0)" class="text-danger fw-semibold text-decoration-none">Place Hold Queue →</a>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Main Circulation Split Grid (60% Form, 40% Live Preview Sidebar) -->
    <div class="row g-4 circ-grid-split">
        <!-- Left: Circulation Form -->
        <div class="col-lg-7">
            <div class="circ-card h-100">
                <div class="circ-card-header">
                    <div>
                        <h3 class="circ-card-title">
                            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#1d4ed8">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            Issue New Loan / Circulation Desk
                        </h3>
                        <p class="text-muted small mb-0 mt-1">Complete all fields below confirming physical item handover.</p>
                    </div>
                    <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none p-0 fw-semibold" onclick="document.getElementById('loanForm').reset(); resetPreviews();">
                        Reset
                    </button>
                </div>

                <div class="circ-card-body">
                    <form id="loanForm" method="post" asp-page-handler="Borrow">
                        <!-- Member Field -->
                        <div class="mb-3">
                            <label class="circ-label" for="memberSelect">
                                <span>Member <span class="text-danger">*</span></span>
                                <span class="circ-hint text-primary" style="cursor: pointer;">Scan Patron Barcode</span>
                            </label>
                            <select id="memberSelect" name="SelectedUserId" class="circ-select" onchange="onMemberChanged(this)">
                                @foreach (var m in Model.ViewModel.Members)
                                {
                                    <option value="@m.Id"
                                            selected="@(m.Id == Model.SelectedUserId)"
                                            data-name="@m.FullName"
                                            data-email="@m.Email"
                                            data-memberid="@m.MemberId"
                                            data-initials="@m.Initials"
                                            data-activeloans="@m.ActiveLoansCount"
                                            data-maxquota="@m.MaxQuota"
                                            data-overdue="@m.OverdueCount"
                                            data-standing="@m.Standing">
                                        @m.FullName - @m.MemberId (@m.Email)
                                    </option>
                                }
                            </select>
                            <div class="d-flex align-items-center justify-content-between mt-2">
                                <span class="circ-badge circ-badge-emerald" id="patronBadgeLabel">
                                    <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                    </svg>
                                    Patron Card Validated <span id="patronBadgeId">@(member?.MemberId ?? "#MB-4820")</span>
                                </span>
                                <span class="circ-hint">Tier: Standard Academic</span>
                            </div>
                        </div>

                        <!-- Book Field -->
                        <div class="mb-3">
                            <label class="circ-label" for="bookSelect">
                                <span>Book <span class="text-danger">*</span></span>
                                <span class="circ-hint">Catalog ID / ISBN Lookup</span>
                            </label>
                            <select id="bookSelect" name="SelectedBookId" class="circ-select" onchange="onBookChanged(this)">
                                @foreach (var b in Model.ViewModel.Books)
                                {
                                    <option value="@b.Id"
                                            selected="@(b.Id == Model.SelectedBookId)"
                                            data-title="@b.Title"
                                            data-author="@b.Author"
                                            data-isbn="@b.ISBN"
                                            data-category="@b.CategoryName"
                                            data-shelflocation="@b.ShelfLocation"
                                            data-total="@b.TotalCopies"
                                            data-available="@b.AvailableCopies"
                                            data-instock="@(b.InStock ? "true" : "false")">
                                        @b.Title (@b.AvailableCopies available of @b.TotalCopies)
                                    </option>
                                }
                            </select>
                            <div class="circ-hint">Select a book title with confirmed physical stock in shelf.</div>
                        </div>

                        <!-- Date Grid (Auto-filled & Calculated Due Date) -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label class="circ-label">Borrow Date (Auto-filled) <span class="text-danger">*</span></label>
                                <input type="text" class="circ-input circ-input-readonly" value="@DateTime.Today.ToString("MMM dd, yyyy")" readonly />
                                <div class="circ-hint">Not editable during standard circulation checkout.</div>
                            </div>
                            <div class="col-sm-6">
                                <label class="circ-label">
                                    <span>Calculated Due Date <span class="text-danger">*</span></span>
                                    <span class="circ-badge circ-badge-emerald">+14 Days</span>
                                </label>
                                <input type="text" class="circ-input circ-input-readonly" value="@DateTime.Today.AddDays(14).ToString("MMM dd, yyyy")" readonly />
                                <div class="circ-hint">Standard 14 days - auto-policy applied.</div>
                            </div>
                        </div>

                        <!-- Terms Notice Box -->
                        <div class="circ-notice-box mb-4">
                            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#2563eb" class="flex-shrink-0 mt-1">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                            <div>
                                <div class="circ-notice-title">Patron circulation notification terms</div>
                                <p class="circ-notice-desc">
                                    Patron is alerted to return by <strong>@DateTime.Today.AddDays(14).ToString("MMM dd, yyyy")</strong>. The patron will receive an automated email notice 48 hours prior to loan expiry.
                                </p>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-page="./Index" class="circ-btn-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="circ-btn-primary">
                                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                </svg>
                                Confirm Borrow
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right: Live Patron & Book Preview Cards -->
        <div class="col-lg-5">
            <div class="d-flex flex-column gap-3">
                <!-- Patron Circulation Status Card -->
                <div class="circ-card">
                    <div class="circ-card-header py-3">
                        <span class="circ-card-title fs-6">PATRON CIRCULATION STATUS</span>
                        <span class="circ-badge circ-badge-emerald" id="previewPatronStatusBadge">• Active Member</span>
                    </div>
                    <div class="circ-card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="circ-patron-avatar" id="previewAvatar">
                                @(member?.Initials ?? "SA")
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0 text-slate-900" id="previewPatronName">@(member?.FullName ?? "Sara Ahmed")</h5>
                                <div class="text-muted small" id="previewPatronEmail">@(member?.Email ?? "sara.ahmed@example.com")</div>
                                <div class="text-secondary small mt-1">
                                    <span id="previewPatronId">ID: @(member?.MemberId ?? "#MB-4820")</span> • Tier: Standard Academic
                                </div>
                            </div>
                        </div>

                        <!-- Quota Progress -->
                        <div class="mb-3 pt-2 border-top">
                            <div class="d-flex justify-content-between small fw-semibold text-slate-700">
                                <span>Active Loans Quota:</span>
                                <span id="previewQuotaText">@(member?.ActiveLoansCount ?? 2) of @(member?.MaxQuota ?? 3) books checked out</span>
                            </div>
                            <div class="circ-quota-bar">
                                @{
                                    var activeCount = member?.ActiveLoansCount ?? 2;
                                    var maxQuota = member?.MaxQuota ?? 3;
                                    var pct = Math.Min(100, (int)((activeCount / (double)maxQuota) * 100));
                                }
                                <div class="circ-quota-fill" id="previewQuotaFill" style="width: @(pct)%;"></div>
                            </div>
                            <div class="d-flex justify-content-between small text-muted mt-1">
                                <span id="previewSlotsRemaining">@(Math.Max(0, maxQuota - activeCount)) slot remaining</span>
                                <span class="text-primary">Quota limit: 3</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <div>
                                <span class="text-muted small">Overdue Items:</span>
                                <strong class="ms-1 small" id="previewOverdue">@(member?.OverdueCount ?? 0) Items</strong>
                            </div>
                            <span class="circ-badge circ-badge-blue" id="previewStanding">
                                @(member?.Standing ?? "Good Standing")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Selected Book Inventory Card -->
                <div class="circ-card">
                    <div class="circ-card-header py-3">
                        <span class="circ-card-title fs-6">SELECTED BOOK INVENTORY</span>
                        <span class="circ-badge @(book?.InStock == true ? "circ-badge-emerald" : "circ-badge-rose")" id="previewBookStockBadge">
                            @(book?.InStock == true ? "• In Stock" : "• Out of Stock")
                        </span>
                    </div>
                    <div class="circ-card-body">
                        <div class="d-flex gap-3 align-items-start">
                            <div class="p-3 bg-light rounded-3 border text-primary text-center flex-shrink-0" style="width: 70px;">
                                <svg width="34" height="34" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                </svg>
                            </div>
                            <div>
                                <span class="badge bg-light text-primary border mb-1" id="previewCategory">@(book?.CategoryName ?? "ENGINEERING / TECH")</span>
                                <h6 class="fw-bold mb-1 text-slate-900" id="previewBookTitle">@(book?.Title ?? "Clean Code: A Handbook of Agile Software Craftsmanship")</h6>
                                <div class="text-muted small" id="previewBookAuthor">By @(book?.Author ?? "Robert C. Martin (Uncle Bob)")</div>
                                <div class="text-secondary small mt-1" id="previewBookIsbn">ISBN: @(book?.ISBN ?? "978-0132350884")</div>
                                <div class="text-secondary small mt-1" id="previewShelfLocation">Shelf: @(book?.ShelfLocation ?? "2nd Floor • Section T4, Shelf 12")</div>
                            </div>
                        </div>

                        <!-- 3-Metrics Grid -->
                        <div class="circ-book-metrics-grid">
                            <div>
                                <div class="circ-book-metric-val" id="metricTotal">@(book?.TotalCopies ?? 5)</div>
                                <div class="circ-book-metric-label">Total Catalog</div>
                            </div>
                            <div>
                                <div class="circ-book-metric-val text-success" id="metricAvailable">@(book?.AvailableCopies ?? 3)</div>
                                <div class="circ-book-metric-label">Available Shelf</div>
                            </div>
                            <div>
                                <div class="circ-book-metric-val text-primary" id="metricActiveLoan">@(book?.ActiveLoans ?? 2)</div>
                                <div class="circ-book-metric-label">In Active Loan</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Circulation Desk Alert Status Showcase (Evaluator Sandbox) -->
    <div class="mt-5 pt-4 border-top">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold text-slate-900 mb-0">Circulation Desk Alert Status Showcase</h5>
                <p class="text-muted small mb-0">Terminal feedback banners triggered on circulation initiation or system guard rails.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-page="./Borrow" asp-route-simulate="success" class="btn btn-sm btn-outline-success">Simulate Success</a>
                <a asp-page="./Borrow" asp-route-simulate="nostock" class="btn btn-sm btn-outline-danger">Simulate No Stock</a>
                <a asp-page="./Borrow" asp-route-simulate="duplicate" class="btn btn-sm btn-outline-warning">Simulate Duplicate</a>
            </div>
        </div>

        <div class="row g-3">
            <!-- Showcase 1: Success -->
            <div class="col-md-6">
                <div class="circ-alert-card circ-alert-success m-0 h-100">
                    <div class="circ-alert-icon">
                        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div class="circ-alert-body">
                        <div class="circ-alert-header">
                            <h4 class="circ-alert-title">Book borrowed successfully</h4>
                            <span class="circ-badge circ-badge-emerald">SUCCESS</span>
                        </div>
                        <p class="circ-alert-desc">
                            Inventory status updated instantly. Transaction permitted with reference #LN-3827. Assigned to member Sara Ahmed.
                        </p>
                        <div class="circ-alert-footer">
                            <span>Return Due: Nov 07, 2024 (14 Day)</span>
                            <span class="text-success fw-semibold">Print Receipt ↗</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Showcase 2: No Available Copies -->
            <div class="col-md-6">
                <div class="circ-alert-card circ-alert-danger m-0 h-100">
                    <div class="circ-alert-icon">
                        <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <div class="circ-alert-body">
                        <div class="circ-alert-header">
                            <h4 class="circ-alert-title">No available copies for this book</h4>
                            <span class="circ-badge circ-badge-rose">REJECTED</span>
                        </div>
                        <p class="circ-alert-desc">
                            All 5 registered copies of this title are currently loaned out or placed on hold. Checkout cannot proceed until an active loan is cleared.
                        </p>
                        <div class="circ-alert-footer">
                            <span>Earliest Estimated Return: Oct 28, 2024</span>
                            <span class="text-danger fw-semibold">Place Hold Queue →</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onMemberChanged(select) {
            const opt = select.options[select.selectedIndex];
            if (!opt) return;

            const name = opt.getAttribute('data-name');
            const email = opt.getAttribute('data-email');
            const memberId = opt.getAttribute('data-memberid');
            const initials = opt.getAttribute('data-initials');
            const activeLoans = parseInt(opt.getAttribute('data-activeloans') || '0');
            const maxQuota = parseInt(opt.getAttribute('data-maxquota') || '3');
            const overdue = opt.getAttribute('data-overdue') || '0';
            const standing = opt.getAttribute('data-standing') || 'Good Standing';

            document.getElementById('previewPatronName').innerText = name;
            document.getElementById('previewPatronEmail').innerText = email;
            document.getElementById('previewPatronId').innerText = 'ID: ' + memberId;
            document.getElementById('previewAvatar').innerText = initials;
            document.getElementById('patronBadgeId').innerText = memberId;

            document.getElementById('previewQuotaText').innerText = `${activeLoans} of ${maxQuota} books checked out`;
            const pct = Math.min(100, Math.round((activeLoans / maxQuota) * 100));
            document.getElementById('previewQuotaFill').style.width = pct + '%';
            document.getElementById('previewSlotsRemaining').innerText = `${Math.max(0, maxQuota - activeLoans)} slot remaining`;
            document.getElementById('previewOverdue').innerText = `${overdue} Items`;
            document.getElementById('previewStanding').innerText = standing;
        }

        function onBookChanged(select) {
            const opt = select.options[select.selectedIndex];
            if (!opt) return;

            const title = opt.getAttribute('data-title');
            const author = opt.getAttribute('data-author');
            const isbn = opt.getAttribute('data-isbn');
            const category = opt.getAttribute('data-category');
            const shelf = opt.getAttribute('data-shelflocation');
            const total = parseInt(opt.getAttribute('data-total') || '5');
            const available = parseInt(opt.getAttribute('data-available') || '0');
            const inStock = opt.getAttribute('data-instock') === 'true';

            document.getElementById('previewBookTitle').innerText = title;
            document.getElementById('previewBookAuthor').innerText = 'By ' + author;
            document.getElementById('previewBookIsbn').innerText = 'ISBN: ' + isbn;
            document.getElementById('previewCategory').innerText = category;
            document.getElementById('previewShelfLocation').innerText = 'Shelf: ' + shelf;

            document.getElementById('metricTotal').innerText = total;
            document.getElementById('metricAvailable').innerText = available;
            document.getElementById('metricActiveLoan').innerText = Math.max(0, total - available);

            const stockBadge = document.getElementById('previewBookStockBadge');
            if (inStock) {
                stockBadge.className = 'circ-badge circ-badge-emerald';
                stockBadge.innerText = '• In Stock';
            } else {
                stockBadge.className = 'circ-badge circ-badge-rose';
                stockBadge.innerText = '• Out of Stock';
            }
        }
    </script>
}
