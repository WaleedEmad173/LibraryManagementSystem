@{
    ViewData["Title"] = "Access Denied";
    var timestamp = DateTime.UtcNow.ToString("HH:mm:ss") + " UTC";
}

<div class="d-flex flex-column justify-content-center align-items-center py-5 min-vh-75">
    <div class="card access-card border-0 shadow-sm rounded-4 p-4 p-sm-5 text-center" style="width: 100%; max-width: 540px; background: #ffffff;">
        <!-- Lock Icon Box -->
        <div class="lock-icon-box mx-auto mb-3">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </div>

        <!-- Status Pill -->
        <div>
            <span class="status-pill-403">
                <span class="status-dot-403"></span>
                <span>HTTP 403 • Access Restricted</span>
            </span>
        </div>

        <!-- Title & Subtitles -->
        <h2 class="access-title">Access Denied</h2>
        <h5 class="access-subtitle">You do not have permission to view this directory or archive.</h5>
        <p class="access-description">
            This resource is reserved strictly for certified staff and system administrators. Your current session credentials do not fulfill the authorization criteria for this terminal.
        </p>

        <!-- Privileges Info Box -->
        <div class="privileges-box text-start">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="privileges-header">REQUIRED PRIVILEGES</span>
                <span class="security-level">Security Level Tier 2+</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge-role-admin">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    Admin Role
                </span>
                <span class="badge-role-librarian">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                    </svg>
                    Librarian Role
                </span>
                <span class="badge-role-unauthorized">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Standard Member (Unauthorized)
                </span>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-center gap-2 mb-4">
            <a href="/" class="btn btn-primary-home d-inline-flex align-items-center gap-2 text-decoration-none">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Back to Home</span>
            </a>
            <a href="mailto:support@librarysystem.org" class="btn btn-contact-help d-inline-flex align-items-center gap-2 text-decoration-none">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                    <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                </svg>
                <span>Contact Help Desk</span>
            </a>
        </div>

        <!-- Terminal & Timestamp Meta Info -->
        <div class="d-flex justify-content-between align-items-center terminal-footer-note pt-2 border-top">
            <span>Terminal Node: <strong class="text-secondary font-monospace">SYS_SRV_01M</strong></span>
            <span>Timestamp: <strong class="text-secondary font-monospace">@timestamp</strong></span>
        </div>
    </div>
</div>

<style>
    .access-card {
        border-radius: 20px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    }

    .lock-icon-box {
        width: 60px;
        height: 60px;
        background-color: #fffbeb;
        border: 1px solid #fef3c7;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .status-pill-403 {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #fef2f2;
        color: #dc2626;
        border: 1px solid #fee2e2;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .status-dot-403 {
        width: 6px;
        height: 6px;
        background-color: #dc2626;
        border-radius: 50%;
        display: inline-block;
    }

    .access-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #0f172a;
        margin-top: 14px;
        margin-bottom: 6px;
    }

    .access-subtitle {
        font-size: 0.95rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }

    .access-description {
        font-size: 0.85rem;
        color: #64748b;
        max-width: 460px;
        margin: 0 auto 20px;
        line-height: 1.5;
    }

    .privileges-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 24px;
    }

    .privileges-header {
        font-size: 0.72rem;
        font-weight: 700;
        color: #64748b;
        letter-spacing: 0.8px;
        text-transform: uppercase;
    }

    .security-level {
        font-size: 0.72rem;
        font-weight: 600;
        color: #64748b;
    }

    .badge-role-admin {
        background-color: #fee2e2;
        color: #991b1b;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
    }

    .badge-role-librarian {
        background-color: #dbeafe;
        color: #1e40af;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
    }

    .badge-role-unauthorized {
        background-color: #f1f5f9;
        color: #64748b;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
    }

    .btn-primary-home {
        background-color: #1e3a8a;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 0.88rem;
        font-weight: 600;
        transition: background-color 0.15s;
    }

    .btn-primary-home:hover {
        background-color: #172554;
        color: #ffffff;
    }

    .btn-contact-help {
        background-color: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 9px 20px;
        font-size: 0.88rem;
        font-weight: 600;
        transition: background-color 0.15s, border-color 0.15s;
    }

    .btn-contact-help:hover {
        background-color: #e2e8f0;
        color: #0f172a;
    }

    .terminal-footer-note {
        font-size: 0.75rem;
        color: #94a3b8;
    }
</style>
